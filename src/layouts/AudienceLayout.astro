---
import ContactPanel from "../components/ContactPanel.astro";
import BaseLayout, { type Crumb } from "./BaseLayout.astro";

/**
 * Shared shell for the four audience zones. Each zone sets its own accent
 * colour, which is applied as a CSS custom property so child components and the
 * section rule pick it up without a separate stylesheet per zone.
 */
interface Props {
	title: string;
	lead?: string | null;
	description?: string | null;
	/** CSS custom property name holding the accent colour. */
	accent?: string;
	breadcrumbs?: Crumb[];
	/** Hide the standard contact panel where a page supplies its own. */
	hideContact?: boolean;
}

const {
	title,
	lead,
	description,
	accent = "var(--rvs-audience-parent)",
	breadcrumbs,
	hideContact = false,
} = Astro.props;
---

<BaseLayout
	title={title}
	description={description}
	breadcrumbs={breadcrumbs ?? [{ label: "Home", href: "/" }, { label: title }]}
>
	<div class="rvs-zone" style={`--rvs-zone-accent: ${accent}`}>
		<header class="rvs-zone__header">
			<h1 class="govuk-heading-xl">{title}</h1>
			{lead && <p class="govuk-body-l">{lead}</p>}
		</header>

		<slot />

		{
			!hideContact && (
				<div class="rvs-zone__contact">
					<ContactPanel />
				</div>
			)
		}
	</div>
</BaseLayout>

<style>
	.rvs-zone__header {
		border-top: 8px solid var(--rvs-zone-accent);
		padding: 1.5rem 0 0.5rem;
		margin-bottom: 1rem;
	}

	.rvs-zone :global(h2) {
		margin-top: 2rem;
	}

	.rvs-zone__contact {
		margin-top: 3rem;
	}
</style>
