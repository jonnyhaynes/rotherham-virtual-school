---
import { getSiteSettingsWithCacheHint } from "emdash";
import { createPublicPageContext } from "emdash/page";
import { EmDashBodyEnd, EmDashBodyStart, EmDashHead } from "emdash/ui";
import PrototypeNotice from "../components/PrototypeNotice.astro";
import YorkshireRose from "../components/YorkshireRose.astro";
import ContactPanel from "../components/ds/ContactPanel.astro";
import DsFooter from "../components/ds/Footer.astro";
import DsHeader from "../components/ds/Header.astro";
import SectionDivider from "../components/ds/SectionDivider.astro";
import SkipLink from "../components/ds/SkipLink.astro";
import { DS_FOOTER_LINKS, DS_FOOTER_NAV, DS_NAV } from "../data/ds-nav";
import "../styles/main.scss";
import { SITE_DEFAULTS, resolveSiteIdentity } from "../utils/site";

/** The design system's five audience ids, as used by `data-audience`. */
type Audience =
	| "young-people"
	| "parents-carers"
	| "schools"
	| "social-workers"
	| "professionals";

interface Props {
	title: string;
	pageTitle?: string | null;
	description?: string | null;
	image?: string | null;
	canonical?: string | null;
	/** EmDash content reference, enables plugin page contributions. */
	content?: { collection: string; id: string; slug?: string | null };
	/** Extra classes for <main>. */
	mainClass?: string;
	/**
	 * Show the standard "get in touch" strip at the foot of the page. On for
	 * every page; off only where the page carries its own contact panel, so the
	 * strip never appears twice.
	 */
	showContact?: boolean;
	/**
	 * Show the decorative band of the brand motif at the foot of the page. On by
	 * default so the motif runs through the whole site; off where a page already
	 * carries its own motif (the 404's pattern block), so none shows two.
	 */
	showMotif?: boolean;
	/** Sets `data-audience` on `<main>`, which drives the accent tokens. */
	audience?: Audience;
}

const {
	title,
	pageTitle,
	description,
	image,
	canonical,
	content,
	mainClass,
	showContact = true,
	showMotif = true,
	audience,
} = Astro.props;

const { data: settings, cacheHint } = await getSiteSettingsWithCacheHint();
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

const { siteTitle, siteTagline } = resolveSiteIdentity(settings);
const titleIncludesSiteName =
	title === siteTitle ||
	title.endsWith(` | ${siteTitle}`) ||
	title.endsWith(` — ${siteTitle}`);
const fullTitle = titleIncludesSiteName ? title : `${title} — ${siteTitle}`;
const pageDescription = description ?? siteTagline;
const currentPath = Astro.url.pathname;

// Absolute URLs, so every page carries a canonical link and a social card even
// where a page or a CMS entry supplies neither. `Astro.site` is set in
// astro.config.mjs; the brand app icon is the default card image.
const siteOrigin = (Astro.site ?? new URL(Astro.url.origin)).origin;
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, siteOrigin).href;
const socialImage = image ?? new URL("/assets/rvs/rvs-app-icon.png", siteOrigin).href;

const pageCtx = createPublicPageContext({
	Astro,
	kind: content ? "content" : "custom",
	pageType: "website",
	title: fullTitle,
	pageTitle: pageTitle ?? title,
	description: pageDescription,
	canonical: canonicalUrl,
	image: socialImage,
	content,
	siteName: siteTitle,
});
---

<!doctype html>
<html lang="en-GB">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<meta name="theme-color" content="#172b4d" />
		<meta property="og:locale" content="en_GB" />
		<!--
			Prototype safeguards: this is an unaffiliated demonstration build, so it
			must stay out of search engines. Remove these two tags, the PrototypeNotice
			component below, the X-Robots-Tag header in vercel.json and the blanket
			disallow in public/robots.txt to take the site live for real.
		-->
		<meta name="robots" content="noindex, nofollow" />
		<meta name="googlebot" content="noindex, nofollow, noimageindex" />
		<title>{fullTitle}</title>
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="icon" href="/assets/rvs/rvs-app-icon.png" type="image/png" sizes="360x360" />
		<link rel="apple-touch-icon" href="/assets/rvs/rvs-app-icon.png" />
		<link rel="manifest" href="/site.webmanifest" />
		<EmDashHead page={pageCtx} />
	</head>
	<body>
		<EmDashBodyStart page={pageCtx} />

		<SkipLink />
		<DsHeader
			navigation={DS_NAV.map((item) => ({
				...item,
				active: currentPath.startsWith(item.href),
			}))}
		/>

		{/*
			`data-audience` on <main> is what switches the accent tokens the hero,
			panels and cards read from.
		*/}
		<main id="main-content" data-audience={audience}>
			<slot name="hero" />
			<div class:list={["rvs-main", "rvs-stack", mainClass]}>
				<slot />
				{
					showContact && (
						<ContactPanel
							variant="inline"
							title="Get in touch"
							phone="01709 822307"
							phoneHours="(Mon – Fri, 9am – 5pm)"
							email={SITE_DEFAULTS.email}
							contactHref="/contact/"
						/>
					)
				}
			</div>
		</main>

		{/* One band of the brand motif closes every page, so the motif runs
		    consistently across the site. Decorative; see `showMotif`. */}
		{showMotif && <SectionDivider variant="pattern" />}

		<DsFooter links={DS_FOOTER_LINKS} navigationGroups={DS_FOOTER_NAV}>
			{/*
				The council logo goes in the footer's `partner` slot: the design
				system says it is not part of the system and must be supplied by
				the council, so it is not bundled with the components.
			*/}
			<img
				slot="partner"
				src="/brand/rmbc-logo-white.svg"
				alt="Rotherham Metropolitan Borough Council"
				width="132"
				height="46"
				loading="lazy"
			/>
			{/*
				The Colouring Code house credit goes in the footer's `credit`
				slot — the same line the other Colouring Code sites sign off with.
				The rose is decorative, so the credit still reads as a sentence.
			*/}
			<span slot="credit">
				Forged in Yorkshire{" "}
				<YorkshireRose />{" "}
				by <a href="https://www.colouringcode.com" rel="noopener noreferrer" target="_blank">
					Colouring Code
				</a>
			</span>
		</DsFooter>

		<PrototypeNotice />

		<EmDashBodyEnd page={pageCtx} />
	</body>
</html>
