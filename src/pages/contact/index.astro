---
import ContactPanel from "../../components/ds/ContactPanel.astro";
import Hero from "../../components/ds/Hero.astro";
import Link from "../../components/ds/Link.astro";
import MapEmbed from "../../components/ds/MapEmbed.astro";
import Panel from "../../components/ds/Panel.astro";
import QuickLinks from "../../components/ds/QuickLinks.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { SITE_DEFAULTS } from "../../utils/site";

const ADDRESS = [
	"Rotherham Virtual School",
	"Riverside House",
	"Main Street",
	"Rotherham",
	"S60 1AE",
];
---

<BaseLayout
	title="Contact us"
	description="How to contact Rotherham Virtual School."
	showContact={false}
>
	<Hero
		slot="hero"
		variant="compact"
		title="Contact us"
		lead="Get in touch with the Virtual School team. If you are not sure who you need, use the team inbox and we will pass your message on."
		breadcrumbs={[{ label: "Home", href: "/" }, { label: "Contact us" }]}
	/>

	<Panel tone="help" title="Emergency">
		<p>
			If a child is in immediate danger, call 999. To report a concern about a child's safety,
			contact Rotherham's Children's Social Care team — do not use the Virtual School inbox.
		</p>
		<Link
			slot="actions"
			href="https://www.rotherham.gov.uk/child-protection/report-concern-child-young-person"
			variant="arrow"
			external={true}
		>
			Report a concern about a child or young person
		</Link>
	</Panel>

	<div class="rvs-two-col">
		<div class="rvs-stack">
			<ContactPanel
				variant="stacked"
				title="Virtual School team"
				email={SITE_DEFAULTS.email}
				address={ADDRESS}
				contactHref="/our-team/"
				contactLabel="See the team and what they cover"
			/>

			<QuickLinks
				heading="Other useful contacts"
				links={[
					{
						label: "Report a concern about a child or young person",
						href: "https://www.rotherham.gov.uk/child-protection/report-concern-child-young-person",
						external: true,
					},
					{ label: "Rotherham Council", href: "https://www.rotherham.gov.uk/", external: true },
				]}
			/>
		</div>

		<MapEmbed title="Riverside House" address={ADDRESS} />
	</div>
</BaseLayout>
