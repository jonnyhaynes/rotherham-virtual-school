---
import { getEmDashCollection } from "emdash";
import Card from "../../components/ds/Card.astro";
import DocumentLink from "../../components/ds/DocumentLink.astro";
import FilterPanel from "../../components/ds/FilterPanel.astro";
import Grid from "../../components/ds/Grid.astro";
import Hero from "../../components/ds/Hero.astro";
import StateMessage from "../../components/ds/StateMessage.astro";
import { formatDate } from "../../components/ds/assets";
import { AUDIENCES } from "../../data/audiences";
import BaseLayout from "../../layouts/BaseLayout.astro";

const { entries, cacheHint } = await getEmDashCollection("documents", { limit: 200 });
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

const CATEGORY_LABELS: Record<string, string> = {
	policy: "Policies",
	guidance: "Guidance",
	form: "Forms and templates",
	report: "Reports",
	other: "Other useful links",
};

const CATEGORY_ORDER = ["policy", "guidance", "form", "report", "other"];

const AUDIENCE_LABELS: Record<string, string> = {
	"young-people": "Young people",
	"parents-carers": "Parents and carers",
	schools: "Schools",
	"social-workers": "Social workers",
	professionals: "Professionals",
	all: "Everyone",
};

const selectedAudiences = Astro.url.searchParams.getAll("audience");

const documents = [...entries]
	.filter((doc) => {
		if (selectedAudiences.length === 0) return true;
		const audience = String(doc.data.audience ?? "all");
		return audience === "all" || selectedAudiences.includes(audience);
	})
	.sort((a, b) => String(a.data.title).localeCompare(String(b.data.title)));

const asString = (value: unknown) => (value == null ? null : String(value));

const fileType = (url?: string | null) => {
	if (!url) return null;
	const name = url.split("?")[0];
	const ext = name.includes(".") ? name.split(".").pop() : null;
	return ext ? ext.toUpperCase() : null;
};

const groups = CATEGORY_ORDER.map((category) => ({
	category,
	label: CATEGORY_LABELS[category] ?? category,
	items: documents.filter((doc) => doc.data.category === category),
})).filter((group) => group.items.length > 0);

const filterGroups = [
	{
		id: "audience",
		legend: "Audience",
		options: AUDIENCES.map((audience) => ({
			value: audience.id,
			label: AUDIENCE_LABELS[audience.id] ?? audience.title,
		})),
	},
];
---

<BaseLayout
	title="Documents"
	description="Policies, guidance, forms and reports from Rotherham Virtual School."
>
	<Hero
		slot="hero"
		variant="compact"
		title="Documents"
		lead="Policies, statutory guidance, forms and reports. Where a document is published nationally, we link to the original source so you always have the current version."
		breadcrumbs={[{ label: "Home", href: "/" }, { label: "Documents" }]}
	/>

	<FilterPanel
		groups={filterGroups}
		selected={{ audience: selectedAudiences }}
		action="/documents/"
	/>

	{
		groups.length === 0 ? (
			<StateMessage state="empty" title="No documents to show">
				<p>
					No documents match your filters. Clear them, or contact the team if you need a
					specific policy or form.
				</p>
			</StateMessage>
		) : (
			groups.map((group) => (
				<section aria-labelledby={`docs-${group.category}`}>
					<h2 class="rvs-section-title" id={`docs-${group.category}`}>{group.label}</h2>
					<Grid as="ul" min="280px">
						{group.items.map((doc) => {
							const externalUrl = asString(doc.data.external_url);
							const fileUrl = doc.data.file?.url ?? null;
							const updated = asString(doc.data.updated_on);
							return externalUrl ? (
								<Card
									as="li"
									href={externalUrl}
									external={true}
									title={String(doc.data.title)}
									text={asString(doc.data.summary)}
									meta={updated ? formatDate(updated) : null}
								/>
							) : (
								<li>
									<DocumentLink
										title={String(doc.data.title)}
										href={fileUrl ?? "#"}
										fileType={fileType(fileUrl)}
										description={asString(doc.data.summary)}
										updated={updated}
										download={Boolean(fileUrl)}
										variant="compact"
									/>
								</li>
							);
						})}
					</Grid>
				</section>
			))
		)
	}
</BaseLayout>
