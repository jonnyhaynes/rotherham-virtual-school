---
import Card from "../../components/ds/Card.astro";
import Checklist from "../../components/ds/Checklist.astro";
import Grid from "../../components/ds/Grid.astro";
import Hero from "../../components/ds/Hero.astro";
import Link from "../../components/ds/Link.astro";
import Panel from "../../components/ds/Panel.astro";
import Prose from "../../components/ds/Prose.astro";
import Signpost from "../../components/ds/Signpost.astro";
import OfstedRecognition from "../../components/OfstedRecognition.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";

const VISION = [
	"put the child's own views and aspirations at the centre of decisions about their education",
	"hold high expectations and refuse to accept low attainment as inevitable",
	"make sure every child is in a good school that can meet their needs",
	"act early when something starts to go wrong, rather than after the event",
	"work in partnership with carers, schools and social care",
];

const RESPONSIBILITIES = [
	"Making sure children are in the right school and are making progress",
	"Providing training and sharing effective practice with schools, carers and social workers",
	"Monitoring the progress, attainment, attendance and exclusion of children in care",
	"Overseeing Personal Education Plans and Pupil Premium Plus",
	"Supporting transitions, including into care, between schools and on to post-16",
].map((label, index) => ({ id: `responsibility-${index}`, label }));
---

<BaseLayout
	title="About us"
	description="What a virtual school is, our vision, and the duties we work to."
>
	<Hero
		slot="hero"
		variant="compact"
		title="About Rotherham Virtual School"
		lead="We are champions for the education of children in care, previously looked-after children and care leavers in Rotherham."
		breadcrumbs={[{ label: "Home", href: "/" }, { label: "About us" }]}
	/>

	<Prose>
		<h2>What a virtual school is</h2>
		<p>
			A virtual school is not a building and children do not attend it. Every local authority
			in England must have a Virtual School Head, whose job is to promote the educational
			achievement of the children the authority looks after.
		</p>
		<p>
			Rotherham Virtual School works with the schools our children attend — in Rotherham and
			anywhere else in the country — as well as with carers, social workers and other
			services.
		</p>
	</Prose>

	<OfstedRecognition
		quote="The virtual school is very well led by experienced leaders, who are supported by committed and skilled staff who deliver a range of targeted support to children in care and their schools. — Ofsted, inspection of Rotherham children's services, 2025"
	/>

	<section>
		<h2 class="rvs-section-title">Our vision</h2>
		<p class="rvs-intro">
			Children in care should have the same opportunity to succeed at school as any other
			child, and better support than most, because of what they have been through. We will:
		</p>
		<Grid as="ul" min="280px">
			{VISION.map((commitment) => <Card as="li" variant="tinted" title={commitment} />)}
		</Grid>
	</section>

	<Checklist
		heading="What we are responsible for"
		interactive={false}
		items={RESPONSIBILITIES}
	/>

	<Panel tone="advice" title="The law and guidance we work to">
		<p>
			Our work is set out in the Children Act 1989 and in the Department for Education's
			statutory guidance.
		</p>
		<p>
			<Link
				href="https://www.gov.uk/government/publications/promoting-the-education-of-looked-after-children"
				external={true}
			>
				Promoting the education of looked-after and previously looked-after children
			</Link>
			(Department for Education) sets out the duties of local authorities, schools and Virtual
			School Heads.
		</p>
	</Panel>

	<Signpost
		title="Our team"
		text="Meet the people who cover each phase and specialist area, and how to reach them."
		href="/our-team/"
		icon="users"
	/>
</BaseLayout>
