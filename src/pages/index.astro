---
import { getEmDashCollection, getSiteSettings } from "emdash";
import AudienceSelector from "../components/ds/AudienceSelector.astro";
import Card from "../components/ds/Card.astro";
import Explainer from "../components/ds/Explainer.astro";
import Grid from "../components/ds/Grid.astro";
import Hero from "../components/ds/Hero.astro";
import Panel from "../components/ds/Panel.astro";
import Link from "../components/ds/Link.astro";
import OfstedRecognition from "../components/OfstedRecognition.astro";
import { AUDIENCES } from "../data/audiences";
import BaseLayout from "../layouts/BaseLayout.astro";
import { resolveSiteIdentity } from "../utils/site";
import { formatDate } from "../components/ds/assets";

const { siteTagline } = resolveSiteIdentity(await getSiteSettings());

const { entries: newsEntries, cacheHint } = await getEmDashCollection("news", {
	limit: 50,
});
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

const latestNews = [...newsEntries]
	.sort(
		(a, b) =>
			new Date(b.data.published_on ?? 0).getTime() -
			new Date(a.data.published_on ?? 0).getTime(),
	)
	.slice(0, 3);

// The design system's five audience ids match this service's five sections one
// to one, so the card colour and glyph come straight from `AudienceSelector`.
// The words are the service's own.
const audiences = AUDIENCES.map((audience) => ({
	id: audience.id,
	label: audience.title,
	description: audience.description,
	href: audience.href,
}));
---

<BaseLayout
	title="Home"
	description={siteTagline}
>
	<Hero
		slot="hero"
		variant="home"
		title="Rotherham Virtual School"
		lead="We are champions for the education of children in care, previously looked-after children and care leavers in Rotherham — wherever they live and whatever school they go to."
		illustration={{ name: "home", alt: "" }}
	/>

	<section>
		<h2 class="rvs-section-title">Who are you?</h2>
		<p class="rvs-intro">Choose the option that fits you best. Each section is written for you.</p>
		<AudienceSelector
			audiences={audiences}
			heading={null}
			label="Who are you? Choose the option that fits you best"
		/>
	</section>

	<Explainer
		id="what-is-a-virtual-school"
		icon="school"
		tone="teal"
		question="What is a virtual school?"
		answer="A virtual school is not a building and children do not attend it. We are a team of professionals who work with schools, carers and social workers to make sure the children we support get the education they deserve."
		points={[
			{ icon: "school", text: "The right school, making progress" },
			{ icon: "graduation", text: "Training and good practice" },
			{ icon: "check-circle", text: "Progress, attendance and exclusions" },
			{ icon: "transition", text: "Moving school, year group or on to college" },
		]}
		href="/about/"
		linkLabel="About us"
	/>

	<Panel tone="help" title="Are you worried about a child?">
		<p>
			If you are worried about a child or young person's safety, contact Rotherham's Children's
			Social Care team.
		</p>
		<Link
			slot="actions"
			href="https://www.rotherham.gov.uk/child-protection/report-concern-child-young-person"
			variant="arrow"
			external={true}
		>
			Report a concern about a child or young person
		</Link>
	</Panel>

	<OfstedRecognition />

	{
		latestNews.length > 0 && (
			<section>
				<h2 class="rvs-section-title">Latest news</h2>
				<Grid as="ul" min="280px">
					{latestNews.map((item) => (
						<Card
							as="li"
							href={`/news/${item.id}`}
							title={String(item.data.title)}
							text={item.data.summary ? String(item.data.summary) : null}
							meta={item.data.published_on ? formatDate(String(item.data.published_on)) : null}
						/>
					))}
				</Grid>
				<p class="rvs-home__more">
					<Link href="/news/" variant="arrow">See all news</Link>
				</p>
			</section>
		)
	}

</BaseLayout>

<style>
	.rvs-home__more {
		margin: var(--space-4) 0 0;
	}
</style>
