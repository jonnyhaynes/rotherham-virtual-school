---
import AudienceAside from "../../components/AudienceAside.astro";
import Panel from "../../components/ds/Panel.astro";
import Prose from "../../components/ds/Prose.astro";
import Steps from "../../components/ds/Steps.astro";
import AudienceLanding from "../../layouts/AudienceLanding.astro";

// The service's own content for parents and carers, presented in the design
// system's audience-page pattern: a hero with the audience eyebrow, the PEP
// process as `Steps`, the aside carrying who's who and related links, and the
// contact panel in the sidebar. The words are the service's.
const PEP_STEPS = [
	{ title: "The school reports", text: "on progress, attendance and any concerns." },
	{ title: "The social worker updates", text: "the care plan." },
	{ title: "Your child is heard", text: "their views are recorded and taken seriously." },
	{ title: "Targets are agreed", text: "SMART targets for the next term." },
];
---

<AudienceLanding
	audience="parents-carers"
	eyebrow="For parents and carers"
	title="Parents and carers"
	headline="Helping the child in your care thrive"
	lead="If you are caring for a child in care, or a child who was previously looked after, the Virtual School is here to help with their education."
	illustration={{ name: "parents-carers", alt: "" }}
	breadcrumbs={[{ label: "Home", href: "/" }, { label: "Parents and carers" }]}
	description="How the Virtual School supports your child's education, what the PEP is, and how to ask for help."
>
	<Prose>
		<h2>What we do for your child</h2>
		<p>
			We are not a school. We are a small team inside Rotherham Council whose job is to make sure
			children in care get the education they are entitled to — wherever they go to school.
		</p>
		<ul>
			<li>We check that your child is in the right school and making progress</li>
			<li>We make sure their school understands what support they need</li>
			<li>We help when things go wrong, such as poor attendance or a risk of exclusion</li>
			<li>We help plan for the move to a new school, to secondary school, or to college</li>
		</ul>
	</Prose>

	<Steps
		heading="The PEP: what to expect"
		intro="Every child in care of school age has a Personal Education Plan (PEP). It is a legal document that records what your child needs to do well, what help they will get, and who is responsible for making it happen. It is reviewed at least three times a year. At the meeting:"
		steps={PEP_STEPS}
	/>

	<Panel tone="advice" title="You have a say">
		<p>
			As the carer, you should be invited to the PEP meeting and you can ask for a copy. If you
			cannot attend, ask for your views to be sent in before the meeting.
		</p>
	</Panel>

	<Prose>
		<h2>Extra funding for your child's school</h2>
		<p>
			Schools receive extra money called <strong>Pupil Premium Plus</strong> for every child in
			care. It is meant to pay for the specific things written in your child's PEP, such as
			tutoring, therapy, books, or equipment.
		</p>
		<p>
			It is not paid to you, and it is not extra pocket money — but you can ask the school how they
			are spending it, and what difference it is making.
		</p>

		<h2>Attendance and moving school</h2>
		<p>
			Children in care are more likely to miss school than other children. We track attendance
			closely and will contact the school early if it starts to slip, so we can sort out the reason
			rather than blame your child.
		</p>
		<p>
			If your child has to move school, they should not lose any school days. Contact us as soon as
			you know a move is likely and we will start arranging the next place.
		</p>
	</Prose>

	<AudienceAside slot="aside" />
</AudienceLanding>
