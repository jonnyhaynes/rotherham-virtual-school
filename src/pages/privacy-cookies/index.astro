---
import Hero from "../../components/ds/Hero.astro";
import OnThisPage from "../../components/ds/OnThisPage.astro";
import Prose from "../../components/ds/Prose.astro";
import Table from "../../components/ds/Table.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { SITE_DEFAULTS } from "../../utils/site";

const sections = [
	{ id: "cookies", label: "Cookies" },
	{ id: "personal-information", label: "Personal information" },
	{ id: "your-rights", label: "Your rights" },
	{ id: "contact", label: "Contact" },
];
---

<BaseLayout
	title="Privacy and cookies"
	description="How Rotherham Virtual School handles personal information and uses cookies on this website."
>
	<Hero
		slot="hero"
		variant="compact"
		title="Privacy and cookies"
		lead="How we handle personal information, and the cookies this website uses."
		breadcrumbs={[{ label: "Home", href: "/" }, { label: "Privacy and cookies" }]}
	/>

	<div class="rvs-two-col">
		<div class="rvs-stack">
			<Prose>
				<p class="rvs-meta">
			[TODO before launch: confirm with the council's Data Protection Officer and insert the
			review date.]
		</p>

		<h2 id="cookies">Cookies</h2>
		<p>
			Cookies are small files saved on your device when you visit a website. This website uses <strong>essential cookies only</strong>.
		</p>
	</Prose>

	<Table
		caption="Essential cookies"
		firstColumnHeader={true}
		columns={[
			{ key: "name", label: "Name" },
			{ key: "purpose", label: "Purpose" },
			{ key: "expires", label: "Expires" },
		]}
		rows={[
			{
				name: "session",
				purpose:
					"Keeps you signed in to the content management system. Only set for Virtual School staff.",
				expires: "When you close your browser",
			},
		]}
	/>

	<Prose>
		<p>
			We do not use advertising or analytics cookies, so there is no cookie banner to dismiss.
			If we add analytics in future, we will ask for your consent first and add a way to change
			your mind.
		</p>

		<h2 id="personal-information">Personal information</h2>
		<p>
			This website is a source of information. We collect as little as possible about visitors,
			and none of it is used to identify you or to build a profile of you.
		</p>
		<p>
			If you email the Virtual School, we will use your message and contact details only to
			deal with your enquiry. Information about a child's education is held in the council's
			case management systems under the council's <a href="https://www.rotherham.gov.uk/privacy" rel="noopener">corporate privacy notice</a
			>, not on this website.
		</p>

		<h2 id="your-rights">Your rights</h2>
		<p>
			You have rights under data protection law, including the right to ask for a copy of the
			information we hold about you. To make a request, contact the council's Data Protection
			Officer through <a href="https://www.rotherham.gov.uk/privacy" rel="noopener"
				>Rotherham Council's privacy pages</a
			>.
		</p>

		<h2 id="contact">Contact</h2>
		<p>
			Questions about this notice can be sent to <a href={`mailto:${SITE_DEFAULTS.email}`}>{SITE_DEFAULTS.email}</a>.
		</p>
			</Prose>
		</div>

		<aside>
			<OnThisPage items={sections} sticky={true} />
		</aside>
	</div>
</BaseLayout>
