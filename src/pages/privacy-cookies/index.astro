---
import PageHeader from "../../components/PageHeader.astro";
import InsetText from "../../components/govuk/InsetText.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { SITE_DEFAULTS } from "../../utils/site";
---

<BaseLayout
	title="Privacy and cookies"
	description="How Rotherham Virtual School handles personal information and uses cookies on this website."
	breadcrumbs={[{ label: "Home", href: "/" }, { label: "Privacy and cookies" }]}
>
	<PageHeader
		title="Privacy and cookies"
		lead="How we handle personal information, and the cookies this website uses."
		meta="[TODO before launch: confirm with the council's Data Protection Officer and insert the review date.]"
	/>

	<h2 class="govuk-heading-l">Cookies</h2>
	<p class="govuk-body">
		Cookies are small files saved on your device when you visit a website. This website uses
		<strong>essential cookies only</strong>.
	</p>
	<table class="govuk-table">
		<caption class="govuk-table__caption govuk-table__caption--s">
			Essential cookies
		</caption>
		<thead class="govuk-table__head">
			<tr class="govuk-table__row">
				<th scope="col" class="govuk-table__header">Name</th>
				<th scope="col" class="govuk-table__header">Purpose</th>
				<th scope="col" class="govuk-table__header">Expires</th>
			</tr>
		</thead>
		<tbody class="govuk-table__body">
			<tr class="govuk-table__row">
				<td class="govuk-table__cell">session</td>
				<td class="govuk-table__cell">
					Keeps you signed in to the content management system. Only set for Virtual School
					staff.
				</td>
				<td class="govuk-table__cell">When you close your browser</td>
			</tr>
		</tbody>
	</table>
	<InsetText>
		<p class="govuk-body">
			We do not use advertising or analytics cookies, so there is no cookie banner to dismiss.
			If we add analytics in future, we will ask for your consent first and add a way to change
			your mind.
		</p>
	</InsetText>

	<h2 class="govuk-heading-l">Personal information</h2>
	<p class="govuk-body">
		This website is a source of information. It has no forms, and does not collect personal
		information about visitors.
	</p>
	<p class="govuk-body">
		If you email the Virtual School, we will use your message and contact details only to deal
		with your enquiry. Information about a child's education is held in the council's case
		management systems under the council's
		<a class="govuk-link" href="https://www.rotherham.gov.uk/privacy" rel="noopener"
			>corporate privacy notice</a
		>, not on this website.
	</p>

	<h2 class="govuk-heading-l">Your rights</h2>
	<p class="govuk-body">
		You have rights under data protection law, including the right to ask for a copy of the
		information we hold about you. To make a request, contact the council's Data Protection
		Officer through
		<a class="govuk-link" href="https://www.rotherham.gov.uk/privacy" rel="noopener"
			>Rotherham Council's privacy pages</a
		>.
	</p>

	<h2 class="govuk-heading-l">Contact</h2>
	<p class="govuk-body">
		Questions about this notice can be sent to
		<a class="govuk-link" href={`mailto:${SITE_DEFAULTS.email}`}>{SITE_DEFAULTS.email}</a>.
	</p>
</BaseLayout>
