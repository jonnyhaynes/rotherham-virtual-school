---
import PageHeader from "../../components/PageHeader.astro";
import WarningText from "../../components/govuk/WarningText.astro";
import InsetText from "../../components/govuk/InsetText.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { SITE_DEFAULTS } from "../../utils/site";

// This page follows the GOV.UK model accessibility statement:
// https://www.gov.uk/guidance/model-accessibility-statement
//
