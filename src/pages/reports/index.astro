---
import { getEmDashCollection } from "emdash";
import Hero from "../../components/ds/Hero.astro";
import NotificationBanner from "../../components/ds/NotificationBanner.astro";
import Prose from "../../components/ds/Prose.astro";
import QuickLinks from "../../components/ds/QuickLinks.astro";
import StatsPanel from "../../components/ds/StatsPanel.astro";
import Table from "../../components/ds/Table.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";

const [outcomesResult, newsResult] = await Promise.all([
	getEmDashCollection("outcomes", { limit: 100 }),
	getEmDashCollection("news", { limit: 100 }),
]);
if (Astro.cache?.enabled) {
	Astro.cache.set(outcomesResult.cacheHint);
	Astro.cache.set(newsResult.cacheHint);
}

const METRIC_LABELS: Record<string, string> = {
	attendance: "School attendance",
	"persistent-absence": "Persistent absence",
	"fixed-term-exclusions": "Fixed-term exclusions",
	"progress-reading": "Progress in reading",
	"progress-maths": "Progress in maths",
	"ppp-spend": "Pupil Premium Plus spend",
	"care-leavers-in-education": "Care leavers in education, employment or training",
};

const rows = [...outcomesResult.entries].sort(
	(a, b) => Number(a.data.order ?? 100) - Number(b.data.order ?? 100),
);

const years = [...new Set(rows.map((row) => String(row.data.academic_year)))].sort();

const reportNews = [...newsResult.entries].find((item) =>
	String(item.data.title).toLowerCase().includes("annual report"),
);

const formatDate = (value: unknown) =>
	value
		? new Date(value as string).toLocaleDateString("en-GB", {
				day: "numeric",
				month: "long",
				year: "numeric",
			})
		: null;

const latestYear = years[years.length - 1];
const latestStats = rows
	.filter((row) => String(row.data.academic_year) === latestYear)
	.map((row) => ({
		value: String(row.data.value),
		label: METRIC_LABELS[String(row.data.metric)] ?? String(row.data.metric),
		description: row.data.comparison ? String(row.data.comparison) : undefined,
	}));
---

<BaseLayout
	title="Outcomes"
	description="How children in care in Rotherham are doing at school, in plain English."
>
	<Hero
		slot="hero"
		variant="compact"
		title="How our children are doing"
		lead="The Virtual School monitors the progress, attainment, attendance and exclusions of children in care. These are the headline figures, explained in plain English."
		breadcrumbs={[{ label: "Home", href: "/" }, { label: "Outcomes" }]}
	/>

	<NotificationBanner tone="important" title="These figures are illustrative, not real">
		<p>
			This is a prototype. The example figures below are placeholder data invented to
			demonstrate the layout — they are <strong>not</strong> Rotherham's published outcomes
			and should not be quoted or relied on.
		</p>
		<p>
			When real data is used: children in care are a small group and their circumstances
			change often, so a single figure can hide a lot. We publish these numbers so that
			schools, carers and young people can see where we are doing well and where we still
			have work to do.
		</p>
	</NotificationBanner>

	{
		rows.length === 0 ? (
			<p class="rvs-muted">Outcome figures for this year have not been published yet.</p>
		) : (
			<>
				<StatsPanel
					heading={`Academic year ${latestYear}`}
					stats={latestStats}
					source="Rotherham Virtual School — placeholder data"
				/>

				{years.map((year) => (
					<section aria-labelledby={`year-${year.replace(/\W/g, "-")}`}>
						<h2 class="rvs-section-title" id={`year-${year.replace(/\W/g, "-")}`}>
							Academic year {year}
						</h2>
						<Table
							caption={`Children in care in Rotherham, ${year}`}
							columns={[
								{ key: "measure", label: "Measure" },
								{ key: "value", label: "Rotherham children in care" },
								{ key: "comparison", label: "Comparison" },
							]}
							rows={rows
								.filter((row) => String(row.data.academic_year) === year)
								.map((row) => ({
									measure: METRIC_LABELS[String(row.data.metric)] ?? String(row.data.metric),
									value: String(row.data.value),
									comparison: row.data.comparison ? String(row.data.comparison) : "",
								}))}
						/>
						{rows
							.filter((row) => String(row.data.academic_year) === year && row.data.note)
							.map((row) => (
								<p>
									<strong>
										{METRIC_LABELS[String(row.data.metric)] ?? String(row.data.metric)}:
									</strong>{" "}
									{String(row.data.note)}
								</p>
							))}
					</section>
				))}
			</>
		)
	}

	<Prose>
		<h2>Annual report</h2>
		<p>
			Our annual report sets out the full picture for the year, including attainment and
			progress data, and our priorities for the year ahead.
		</p>
	</Prose>

	{
		reportNews ? (
			<QuickLinks
				heading={null}
				label="Read the annual report"
				links={[
					{
						label: String(reportNews.data.title),
						href: `/news/${reportNews.id}`,
						meta: formatDate(reportNews.data.published_on) ?? undefined,
					},
				]}
			/>
		) : (
			<p class="rvs-muted">
				The annual report will be published here. Contact the team if you need a copy in the
				meantime.
			</p>
		)
	}
</BaseLayout>
