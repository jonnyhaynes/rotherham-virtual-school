---
import { getEmDashCollection } from "emdash";
import Card from "../../components/ds/Card.astro";
import Grid from "../../components/ds/Grid.astro";
import Hero from "../../components/ds/Hero.astro";
import StateMessage from "../../components/ds/StateMessage.astro";
import Tag from "../../components/ds/Tag.astro";
import AudienceSelector from "../../components/ds/AudienceSelector.astro";
import { formatDate } from "../../components/ds/assets";
import { AUDIENCES } from "../../data/audiences";
import BaseLayout from "../../layouts/BaseLayout.astro";

const { entries, cacheHint } = await getEmDashCollection("news", { limit: 100 });
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

const AUDIENCE_LABELS: Record<string, string> = {
	"young-people": "Young people",
	"parents-carers": "Parents and carers",
	schools: "Schools",
	"social-workers": "Social workers",
	professionals: "Professionals",
	all: "Everyone",
};

type AudienceId =
	| "young-people"
	| "parents-carers"
	| "schools"
	| "social-workers"
	| "professionals";

const selected = (Astro.url.searchParams.get("audience") as AudienceId | null) ?? undefined;

const news = [...entries]
	.filter((item) => !selected || String(item.data.audience) === selected)
	.sort(
		(a, b) =>
			new Date(b.data.published_on ?? 0).getTime() -
			new Date(a.data.published_on ?? 0).getTime(),
	);

// Pills take the short audience name, not the card's full-sentence title, so the
// filter row stays one line instead of wrapping to three.
const PILL_LABELS: Record<string, string> = {
	"young-people": "Young people",
	"parents-carers": "Parents and carers",
	schools: "Schools",
	"social-workers": "Social workers",
	professionals: "Professionals",
};

const pills = AUDIENCES.map((audience) => ({
	id: audience.id,
	label: PILL_LABELS[audience.id] ?? audience.title,
	href: `/news/?audience=${audience.id}`,
}));
---

<BaseLayout
	title="News"
	description="News, updates and newsletters from Rotherham Virtual School."
>
	<Hero
		slot="hero"
		variant="compact"
		title="News"
		lead="Updates from Rotherham Virtual School for children, carers, schools and social workers."
		breadcrumbs={[{ label: "Home", href: "/" }, { label: "News" }]}
	/>

	<AudienceSelector
		variant="pills"
		current={selected}
		heading={null}
		label="Filter news by audience"
		audiences={pills}
	/>

	{
		news.length === 0 ? (
			<StateMessage state="empty" title="There is no news to show yet">
				<p>News and updates will appear here as they are published.</p>
			</StateMessage>
		) : (
			<Grid as="ul" min="280px">
				{news.map((item) => (
					<Card
						as="li"
						href={`/news/${item.id}`}
						title={String(item.data.title)}
						text={item.data.summary ? String(item.data.summary) : null}
						meta={item.data.published_on ? formatDate(String(item.data.published_on)) : null}
					>
						<Tag slot="tag" tone="teal">
							{AUDIENCE_LABELS[String(item.data.audience)] ?? "News"}
						</Tag>
					</Card>
				))}
			</Grid>
		)
	}
</BaseLayout>
