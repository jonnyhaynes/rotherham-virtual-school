---
import {
	decodeSlug,
	getEmDashEntry,
	getSeoMeta,
	getSiteSettings,
} from "emdash";
import { PortableText } from "emdash/ui";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { resolveSiteIdentity } from "../../utils/site";

const slug = decodeSlug(Astro.params.slug);
if (!slug) return Astro.redirect("/404");

const { entry: item, cacheHint } = await getEmDashEntry("news", slug);
if (!item) return Astro.redirect("/404");

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);
const { siteTitle } = resolveSiteIdentity(await getSiteSettings());

const seo = getSeoMeta(item, {
	siteTitle,
	siteUrl: Astro.url.origin,
	path: Astro.url.pathname.replace(/\/$/, ""),
});

const publishedOn = item.data.published_on;
const publishedLabel = publishedOn
	? new Date(publishedOn).toLocaleDateString("en-GB", {
			day: "numeric",
			month: "long",
			year: "numeric",
		})
	: null;
---

<BaseLayout
	title={seo.title}
	pageTitle={seo.ogTitle}
	description={seo.description}
	canonical={seo.canonical}
	image={seo.ogImage}
	content={{ collection: "news", id: item.data.id, slug }}
	breadcrumbs={[
		{ label: "Home", href: "/" },
		{ label: "News", href: "/news/" },
		{ label: item.data.title },
	]}
>
	<article class="rvs-article">
		<h1 class="govuk-heading-xl" {...item.edit.title}>{item.data.title}</h1>
		{
			publishedLabel && (
				<p class="govuk-body-s rvs-article__meta">
					Published{" "}
					<time datetime={new Date(publishedOn).toISOString()}>{publishedLabel}</time>
				</p>
			)
		}
		{
			item.data.featured_image && (
				<div class="rvs-article__image" {...item.edit.featured_image}>
					<img
						src={item.data.featured_image.src}
						alt={item.data.featured_image.alt ?? ""}
					/>
				</div>
			)
		}
		<div class="rvs-prose">
			<PortableText value={item.data.content} />
		</div>
	</article>
</BaseLayout>

<style>
	.rvs-article__meta {
		color: var(--rvs-grey);
	}

	.rvs-article__image img {
		max-width: 100%;
		height: auto;
		margin-bottom: 1.5rem;
	}
</style>
