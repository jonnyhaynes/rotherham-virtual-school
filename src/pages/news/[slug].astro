---
import { decodeSlug, getEmDashEntry, getSeoMeta, getSiteSettings } from "emdash";
import { PortableText } from "emdash/ui";
import ContentMeta from "../../components/ds/ContentMeta.astro";
import Hero from "../../components/ds/Hero.astro";
import Prose from "../../components/ds/Prose.astro";
import QuickLinks from "../../components/ds/QuickLinks.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { resolveSiteIdentity } from "../../utils/site";

const slug = decodeSlug(Astro.params.slug);
if (!slug) return Astro.redirect("/404");

const { entry: item, cacheHint } = await getEmDashEntry("news", slug);
if (!item) return Astro.redirect("/404");

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);
const { siteTitle } = resolveSiteIdentity(await getSiteSettings());

const seo = getSeoMeta(item, {
	siteTitle,
	siteUrl: Astro.url.origin,
	path: Astro.url.pathname.replace(/\/$/, ""),
});

const publishedOn = item.data.published_on ? String(item.data.published_on) : null;
---

<BaseLayout
	title={seo.title}
	pageTitle={seo.ogTitle}
	description={seo.description}
	canonical={seo.canonical}
	image={seo.ogImage}
	content={{ collection: "news", id: item.data.id, slug }}
>
	<Hero
		slot="hero"
		variant="compact"
		eyebrow="News"
		title={String(item.data.title)}
		breadcrumbs={[
			{ label: "Home", href: "/" },
			{ label: "News", href: "/news/" },
			{ label: String(item.data.title) },
		]}
	/>

	<div class="rvs-two-col">
		<article class="rvs-stack--s">
			{publishedOn && <ContentMeta published={publishedOn} />}

			{
				item.data.featured_image && (
					<div class="rvs-article__image" {...item.edit.featured_image}>
						<img
							src={item.data.featured_image.src}
							alt={item.data.featured_image.alt ?? ""}
						/>
					</div>
				)
			}

			<Prose>
				<PortableText value={item.data.content} />
			</Prose>
		</article>

		<aside>
			<QuickLinks
				heading="Related"
				links={[
					{ label: "All news", href: "/news/" },
					{ label: "Training and events", href: "/training-events/" },
					{ label: "Contact the Virtual School", href: "/contact/" },
				]}
			/>
		</aside>
	</div>
</BaseLayout>

<style>
	.rvs-article__image img {
		display: block;
		width: 100%;
		height: auto;
		border-radius: var(--radius-md);
	}
</style>
