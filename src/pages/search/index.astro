---
import { search } from "emdash";
import Hero from "../../components/ds/Hero.astro";
import SearchInput from "../../components/ds/SearchInput.astro";
import SearchResults from "../../components/ds/SearchResults.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";

const query = (Astro.url.searchParams.get("q") ?? "").trim();

// The CMS collections are routable in different places, so map them explicitly
// rather than guessing a URL from the collection name.
const COLLECTION_ROUTES: Record<string, (slug: string) => string> = {
	pages: (slug) => `/${slug}`,
	news: (slug) => `/news/${slug}`,
	events: (slug) => `/training-events/${slug}`,
	documents: (slug) => `/documents/${slug}`,
};

const COLLECTION_LABELS: Record<string, string> = {
	pages: "Page",
	news: "News",
	events: "Training and events",
	documents: "Document",
};

interface Result {
	href: string;
	title: string;
	summary?: string;
	type: string;
}

let results: Result[] = [];
let failed = false;

if (query) {
	try {
		const response = await search(query, { limit: 20 });
		results = response.items.flatMap((item) => {
			const build = COLLECTION_ROUTES[item.collection];
			const slug = item.slug ?? item.id;
			if (!build || !slug) return [];
			const title = item.title ?? slug;
			// Sanitised by EmDash: HTML metacharacters escaped, with only <mark>
			// allowed through for the matched terms. Some entries have no body
			// beyond the title, so the snippet comes back as the title again —
			// drop it rather than print the same line twice.
			const snippet = item.snippet ?? null;
			const snippetText = snippet
				? snippet.replace(/<[^>]*>/g, "").replace(/\s+/g, " ").trim()
				: "";
			return [
				{
					href: build(slug),
					title,
					summary: snippetText && snippetText !== title ? snippet : undefined,
					type: COLLECTION_LABELS[item.collection] ?? item.collection,
				},
			];
		});
	} catch {
		failed = true;
	}
}
---

<BaseLayout
	title={query ? `Search results for “${query}”` : "Search"}
	description="Search the Rotherham Virtual School website."
>
	<Hero
		slot="hero"
		variant="compact"
		title="Search"
		lead="Search for guidance, news, training and documents across the Virtual School website."
		breadcrumbs={[{ label: "Home", href: "/" }, { label: "Search" }]}
	/>

	<SearchInput
		size="large"
		label="Search the Virtual School website"
		defaultValue={query}
		action="/search"
	/>

	{
		query && (
			<SearchResults
				query={query}
				results={results}
				error={failed}
				emptyText="Nothing matched your search. Try a different word, or browse using the menu."
			/>
		)
	}
</BaseLayout>
