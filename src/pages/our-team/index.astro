---
import { getEmDashCollection } from "emdash";
import Grid from "../../components/ds/Grid.astro";
import Hero from "../../components/ds/Hero.astro";
import Panel from "../../components/ds/Panel.astro";
import StateMessage from "../../components/ds/StateMessage.astro";
import TeamProfile from "../../components/ds/TeamProfile.astro";
import Link from "../../components/ds/Link.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { SITE_DEFAULTS } from "../../utils/site";

// Profiles are wide cards: the photo sits beside the body, so the body column is
// only about `card - 162px`, and `virtualschool@rotherham.gov.uk` needs ~230px.
// A 420px track gives a two-up grid wide enough to keep the address on one line.
const { entries, cacheHint } = await getEmDashCollection("team_members", { limit: 100 });
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

const team = [...entries].sort(
	(a, b) => Number(a.data.order ?? 100) - Number(b.data.order ?? 100),
);
---

<BaseLayout
	title="Our team"
	description="Who works in Rotherham Virtual School, what they cover and how to contact them."
>
	<Hero
		slot="hero"
		variant="compact"
		title="Our team"
		lead="The Virtual School is a small team. Each member covers a phase or a specialist area, so you reach the right person quickly."
		breadcrumbs={[{ label: "Home", href: "/" }, { label: "Our team" }]}
	/>

	{
		team.length === 0 ? (
			<StateMessage state="empty" title="Team details coming soon">
				<p>Contact the team inbox and we will put you in touch with the right person.</p>
			</StateMessage>
		) : (
			<Grid as="ul" min="420px">
				{team.map((member) => (
					<li>
						<TeamProfile
							role={String(member.data.role)}
							name={member.data.name ? String(member.data.name) : null}
							photo={member.data.photo?.src ?? null}
							remit={member.data.remit ? String(member.data.remit) : null}
							email={member.data.email ? String(member.data.email) : null}
						/>
					</li>
				))}
			</Grid>
		)
	}

	<Panel tone="help" title="Not sure who you need?">
		<p>
			Email <a class="rvs-link" href={`mailto:${SITE_DEFAULTS.email}`}>{SITE_DEFAULTS.email}</a>
			and your message will be passed to the right person.
		</p>
		<Link slot="actions" href="/contact/" variant="arrow">Contact the team</Link>
	</Panel>
</BaseLayout>
