---
import AudienceAside from "../../components/AudienceAside.astro";
import Checklist from "../../components/ds/Checklist.astro";
import Panel from "../../components/ds/Panel.astro";
import Prose from "../../components/ds/Prose.astro";
import AudienceLanding from "../../layouts/AudienceLanding.astro";

// The service's own content for schools, word for word as the live site has it.
// The warning and the inset become design-system panels with the same words, and
// the "good PEP" list becomes the design system's static checklist.
const PEP_CHECKLIST = [
	"a clear picture of the child's progress and attainment, with evidence",
	"a small number of SMART targets — not a long wish list",
	"the child's own views, in their words",
	"a named adult responsible for each action, and a date",
	"a clear link to how Pupil Premium Plus will be used",
].map((label, index) => ({ id: `pep-${index}`, label }));
---

<AudienceLanding
	audience="schools"
	eyebrow="For schools"
	title="Schools and designated teachers"
	headline="Working together for better outcomes"
	lead="Guidance for schools on the PEP cycle, Pupil Premium Plus, admissions, exclusions and training."
	illustration={{ name: "schools", alt: "" }}
	breadcrumbs={[{ label: "Home", href: "/" }, { label: "Schools and designated teachers" }]}
	description="Designated teacher guidance, PEP deadlines, Pupil Premium Plus, training and admissions for Rotherham schools."
>
	<Prose>
		<h2>The designated teacher</h2>
		<p>
			Every school must have a <strong>designated teacher</strong> for looked-after and previously
			looked-after children. Their role is set out in statutory guidance and includes:
		</p>
		<ul>
			<li>promoting the educational achievement of children in care at the school</li>
			<li>making sure each child has a PEP and that it is reviewed on time</li>
			<li>advising colleagues on how to support the child in class</li>
			<li>making sure Pupil Premium Plus is spent on the child's identified needs</li>
			<li>acting as the point of contact for the Virtual School and social care</li>
		</ul>
		<p>
			Designated teachers should have time allocated for the role. If that is not happening in your
			school, <a href="/contact/">talk to us</a>.
		</p>

		<h2>The PEP cycle</h2>
		<p>
			Every child in care of statutory school age must have a PEP reviewed at least three times a
			year. The PEP is a working document, not a paperwork exercise: it should reflect what is
			actually happening for the child and what will change as a result.
		</p>
		<p>A good PEP has:</p>
	</Prose>

	<Checklist heading="A good PEP" interactive={false} items={PEP_CHECKLIST} />

	<Panel tone="warning" title="PEP timescales">
		<p>
			PEPs must be completed within the statutory timescales. Late or thin PEPs are the most
			common reason we have to challenge a school.
		</p>
	</Panel>

	<Prose>
		<h2>Pupil Premium Plus</h2>
		<p>
			Pupil Premium Plus is paid to the school for children in care and previously looked-after
			children. It is not a general budget top-up. It must be used to meet the educational needs
			identified in the PEP, and schools should be able to show the impact.
		</p>

	</Prose>

	<Panel tone="advice" title="Show us the impact">
		<p>
			When we quality assure a PEP, we look for evidence of what the funding bought and what
			changed for the child. Keep it specific: "weekly 1:1 reading, moved up two book bands"
			beats "extra support".
		</p>
	</Panel>

	<Prose>
		<h2>Admissions, exclusions and part-time timetables</h2>
		<p>
			Children in care are a priority for school places. A school cannot refuse a place or delay
			admission because a child is in care.
		</p>
		<p>
			If you are considering a fixed-term or permanent exclusion, contact the Virtual School first.
			Officially excluded children must be in full-time alternative provision from day six.
			Part-time timetables should be short-term, agreed with us, and reviewed.
		</p>

		<h2>Attachment, trauma and inclusion</h2>
		<p>
			Many children in care have experienced trauma. Behaviour that looks like defiance is often a
			stress response. Small adjustments — predictable routines, a named adult, a quiet space to
			regulate — make a disproportionate difference.
		</p>
		<p>
			We run Attachment Aware Schools training for staff. See <a href="/training-events/">training and events</a> for the current programme.
		</p>
	</Prose>

	<AudienceAside slot="aside" />
</AudienceLanding>
