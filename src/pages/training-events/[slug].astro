---
import { decodeSlug, getEmDashEntry, getSeoMeta, getSiteSettings } from "emdash";
import { PortableText } from "emdash/ui";
import Button from "../../components/ds/Button.astro";
import Hero from "../../components/ds/Hero.astro";
import KeyFacts from "../../components/ds/KeyFacts.astro";
import PageActions from "../../components/ds/PageActions.astro";
import Panel from "../../components/ds/Panel.astro";
import Prose from "../../components/ds/Prose.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { resolveSiteIdentity } from "../../utils/site";

const slug = decodeSlug(Astro.params.slug);
if (!slug) return Astro.redirect("/404");

const { entry: event, cacheHint } = await getEmDashEntry("events", slug);
if (!event) return Astro.redirect("/404");

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);
const { siteTitle } = resolveSiteIdentity(await getSiteSettings());

const seo = getSeoMeta(event, {
	siteTitle,
	siteUrl: Astro.url.origin,
	path: Astro.url.pathname.replace(/\/$/, ""),
});

const AUDIENCE_LABELS: Record<string, string> = {
	"young-people": "Young people",
	"parents-carers": "Parents and carers",
	schools: "Schools",
	"social-workers": "Social workers",
	professionals: "Professionals",
	all: "Everyone",
};

const dateFmt = (value: unknown, options: Intl.DateTimeFormatOptions) =>
	value ? new Date(value as string).toLocaleString("en-GB", options) : null;

const dateLabel = dateFmt(event.data.starts_at, {
	weekday: "long",
	day: "numeric",
	month: "long",
	year: "numeric",
});
const timeLabel = event.data.ends_at
	? `${dateFmt(event.data.starts_at, { hour: "2-digit", minute: "2-digit" })} to ${dateFmt(event.data.ends_at, { hour: "2-digit", minute: "2-digit" })}`
	: dateFmt(event.data.starts_at, { hour: "2-digit", minute: "2-digit" });

const where = event.data.is_online
	? `Online${event.data.location ? ` — ${event.data.location}` : ""}`
	: event.data.location
		? String(event.data.location)
		: null;

const facts = [
	dateLabel && { term: "Date", value: `${dateLabel}${timeLabel ? `, ${timeLabel}` : ""}` },
	where && { term: "Where", value: where },
	event.data.audience && {
		term: "Who it's for",
		value: AUDIENCE_LABELS[String(event.data.audience)] ?? String(event.data.audience),
	},
].filter(Boolean) as { term: string; value: string }[];
---

<BaseLayout
	title={seo.title}
	pageTitle={seo.ogTitle}
	description={seo.description}
	canonical={seo.canonical}
	image={seo.ogImage}
	content={{ collection: "events", id: event.data.id, slug }}
>
	<Hero
		slot="hero"
		variant="compact"
		eyebrow="Training and events"
		title={String(event.data.title)}
		breadcrumbs={[
			{ label: "Home", href: "/" },
			{ label: "Training and events", href: "/training-events/" },
			{ label: String(event.data.title) },
		]}
	/>

	<div class="rvs-two-col">
		<div class="rvs-stack">
			<Prose>
				<PortableText value={event.data.content} />
			</Prose>

			<PageActions actions={["copy", "print"]} />
		</div>

		<aside class="rvs-stack">
			<KeyFacts items={facts} title="When and where" icon="calendar" />

			{
				event.data.booking_url && (
					<Panel tone="advice" title="Book a place">
						<p>Places are booked through our booking page.</p>
						<Button slot="actions" href={String(event.data.booking_url)} icon="arrow-right">
							Book a place
						</Button>
					</Panel>
				)
			}
		</aside>
	</div>
</BaseLayout>
