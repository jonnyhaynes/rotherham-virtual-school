---
import Explainer from "../../components/ds/Explainer.astro";
import Glossary from "../../components/ds/Glossary.astro";
import Grid from "../../components/ds/Grid.astro";
import Panel from "../../components/ds/Panel.astro";
import Prose from "../../components/ds/Prose.astro";
import PupilCard from "../../components/ds/PupilCard.astro";
import type { IconName } from "../../components/ds/icons";
import AudienceLanding from "../../layouts/AudienceLanding.astro";

// The service's own content for children and young people, word for word as the
// live site has it. Only the presentation is the design system's: the four
// jump-links are pupil-zone cards, "Your PEP" is an Explainer, and the words at
// the end are a Glossary.
const CARDS: { title: string; text: string; href: string; icon: IconName; tone: "teal" | "yellow" | "coral" | "purple" }[] = [
	{
		title: "Your PEP",
		text: "What a Personal Education Plan is, and what should happen at your PEP meeting.",
		href: "#your-pep",
		icon: "book",
		tone: "teal",
	},
	{
		title: "Moving to a new school",
		text: "What to expect when you change school or move to a new home.",
		href: "#moving-schools",
		icon: "transition",
		tone: "yellow",
	},
	{
		title: "Going to college or work",
		text: "Help with what comes next after year 11, including money and support.",
		href: "#post-16",
		icon: "graduation",
		tone: "coral",
	},
	{
		title: "Who can help you",
		text: "The people you can talk to if something is worrying you at school.",
		href: "#who-can-help",
		icon: "users",
		tone: "purple",
	},
];

const GLOSSARY = [
	{
		term: "Looked after",
		definition:
			"It means a child or young person who is in the care of the council. Some people say “child in care” instead.",
	},
	{
		term: "Designated teacher",
		definition:
			"A teacher at your school who is responsible for making sure children in care get the help they need.",
	},
	{
		term: "Personal adviser",
		definition:
			"Someone who helps you plan what you will do after school, and supports you until you are 25 if you want them to.",
	},
];
---

<AudienceLanding
	audience="young-people"
	eyebrow="For children and young people"
	title="Children and young people"
	headline="Your education. Your voice. Your future."
	lead="This part of the website is for you. It explains the people who help with your education, and what you can ask for."
	illustration={{ name: "young-people", alt: "" }}
	breadcrumbs={[{ label: "Home", href: "/" }, { label: "Children and young people" }]}
	description="What a virtual school is, what your PEP means, and who you can talk to if you need help."
>
	<Grid as="ul" min="280px">
		{
			CARDS.map((card) => (
				<li>
					<PupilCard
						href={card.href}
						title={card.title}
						text={card.text}
						icon={card.icon}
						tone={card.tone}
					/>
				</li>
			))
		}
	</Grid>

	<Explainer
		id="your-pep"
		icon="document"
		tone="teal"
		question="Your PEP"
		answer="PEP stands for Personal Education Plan. It is a document about you and your learning."
		points={[
			{ icon: "star", text: "What you are good at" },
			{ icon: "heart", text: "What you find difficult, and what help you will get" },
			{ icon: "sprout", text: "What goals you are working towards" },
		]}
	/>

	<Prose>
		<p>
			Your PEP is talked about in a meeting about three times a year. You should be asked what you
			think, and what you want to happen. If you do not want to go to the meeting, you can ask for
			your views to be written down and shared instead.
		</p>
	</Prose>

	<Panel tone="advice" title="It's your PEP">
		<p>
			You have a right to have a say in your PEP. If you feel like nobody asked you, tell your
			social worker, your carer or your teacher.
		</p>
	</Panel>

	<Prose>
		<h2 id="moving-schools">Moving to a new school</h2>
		<p>
			Changing school can happen quickly, and it can feel like a lot. You should not lose any school
			time because of a move.
		</p>
		<p>
			The Virtual School makes sure your new school knows what support you need, and that your PEP
			moves with you. You can ask to visit the new school before you start.
		</p>

		<h2 id="post-16">Going to college or work</h2>
		<p>
			When you finish year 11, you still get support — up to age 25 if you want it. This could be
			help choosing a college course, an apprenticeship, or a job, and help with money for things
			like travel, books or equipment.
		</p>
		<p>
			Your <strong>personal adviser</strong> is the person who helps you with this. If you do not
			know who yours is, ask your social worker.
		</p>

		<h2 id="who-can-help">Who can help you</h2>
		<ul>
			<li><strong>Your carer</strong> — they can raise things with your school.</li>
			<li><strong>Your social worker</strong> — they come to your PEP meetings.</li>
			<li>
				<strong>Your designated teacher</strong> — every school has one. Their job is to look after
				the education of children in care at your school.
			</li>
			<li><strong>The Virtual School</strong> — you can email us any time.</li>
		</ul>
	</Prose>

	<Glossary heading="Words you might hear" terms={GLOSSARY} searchable={false} />
</AudienceLanding>
