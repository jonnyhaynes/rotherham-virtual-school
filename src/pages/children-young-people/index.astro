---
import InsetText from "../../components/govuk/InsetText.astro";
import PupilLayout from "../../layouts/PupilLayout.astro";

const cards = [
	{
		title: "Your PEP",
		text: "What a Personal Education Plan is, and what should happen at your PEP meeting.",
		href: "#your-pep",
	},
	{
		title: "Moving to a new school",
		text: "What to expect when you change school or move to a new home.",
		href: "#moving-schools",
	},
	{
		title: "Going to college or work",
		text: "Help with what comes next after year 11, including money and support.",
		href: "#post-16",
	},
	{
		title: "Who can help you",
		text: "The people you can talk to if something is worrying you at school.",
		href: "#who-can-help",
	},
];
---

<PupilLayout
	title="Children and young people"
	lead="This part of the website is for you. It explains the people who help with your education, and what you can ask for."
	breadcrumbs={[{ label: "Home", href: "/" }, { label: "Children and young people" }]}
>
	<ul class="pupil-cards">
		{
			cards.map((card) => (
				<li>
					<a class="rvs-pupil-card" href={card.href}>
						<h2 class="govuk-heading-m rvs-pupil-card__title">{card.title}</h2>
						<p class="rvs-pupil-card__text">{card.text}</p>
					</a>
				</li>
			))
		}
	</ul>

	<h2 class="govuk-heading-l" id="what-is-a-virtual-school">What is a virtual school?</h2>
	<p>
		<span class="rvs-break-words"><strong>Rotherham Virtual School</strong></span> is not a real
		building and you do not go to it. It is a team of people whose job is to make sure you are
		doing well at school.
	</p>
	<p>
		They check how you are getting on, help if you are finding things hard, and work with your
		school and your carers to sort out problems. They are on your side.
	</p>

	<h2 class="govuk-heading-l" id="your-pep">Your PEP</h2>
	<p>
		PEP stands for <strong>Personal Education Plan</strong>. It is a document about <em>you</em>
		and your learning.
	</p>
	<p>It says:</p>
	<ul>
		<li>what you are good at</li>
		<li>what you find difficult and what help you will get</li>
		<li>what goals you are working towards</li>
	</ul>
	<p>
		Your PEP is talked about in a meeting about three times a year. You should be asked what you
		think, and what you want to happen. If you do not want to go to the meeting, you can ask for
		your views to be written down and shared instead.
	</p>

	<InsetText title="It's your PEP">
		<p>
			You have a right to have a say in your PEP. If you feel like nobody asked you, tell your
			social worker, your carer or your teacher.
		</p>
	</InsetText>

	<h2 class="govuk-heading-l" id="moving-schools">Moving to a new school</h2>
	<p>
		Changing school can happen quickly, and it can feel like a lot. You should not lose any
		school time because of a move.
	</p>
	<p>
		The Virtual School makes sure your new school knows what support you need, and that your PEP
		moves with you. You can ask to visit the new school before you start.
	</p>

	<h2 class="govuk-heading-l" id="post-16">Going to college or work</h2>
	<p>
		When you finish year 11, you still get support — up to age 25 if you want it. This could be
		help choosing a college course, an apprenticeship, or a job, and help with money for things
		like travel, books or equipment.
	</p>
	<p>
		Your <strong>personal adviser</strong> is the person who helps you with this. If you do not
		know who yours is, ask your social worker.
	</p>

	<h2 class="govuk-heading-l" id="who-can-help">Who can help you</h2>
	<ul>
		<li><strong>Your carer</strong> — they can raise things with your school.</li>
		<li><strong>Your social worker</strong> — they come to your PEP meetings.</li>
		<li>
			<strong>Your designated teacher</strong> — every school has one. Their job is to look
			after the education of children in care at your school.
		</li>
		<li><strong>The Virtual School</strong> — you can email us any time.</li>
	</ul>

	<h2 class="govuk-heading-l" id="words">Words you might hear</h2>
	<details class="govuk-details">
		<summary class="govuk-details__summary">
			<span class="govuk-details__summary-text">What does "looked after" mean?</span>
		</summary>
		<div class="govuk-details__text">
			It means a child or young person who is in the care of the council. Some people say
			"child in care" instead.
		</div>
	</details>
	<details class="govuk-details">
		<summary class="govuk-details__summary">
			<span class="govuk-details__summary-text">What does "designated teacher" mean?</span>
		</summary>
		<div class="govuk-details__text">
			A teacher at your school who is responsible for making sure children in care get the
			help they need.
		</div>
	</details>
	<details class="govuk-details">
		<summary class="govuk-details__summary">
			<span class="govuk-details__summary-text">What is a "personal adviser"?</span>
		</summary>
		<div class="govuk-details__text">
			Someone who helps you plan what you will do after school, and supports you until you are
			25 if you want them to.
		</div>
	</details>
</PupilLayout>

<style>
	.pupil-cards {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
		gap: 1.25rem;
		list-style: none;
		padding: 0;
		margin: 0 0 2.5rem;
	}
</style>
