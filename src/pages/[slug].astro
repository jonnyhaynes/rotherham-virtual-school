---
import { decodeSlug, getEmDashEntry, getSeoMeta, getSiteSettings } from "emdash";
import { PortableText } from "emdash/ui";
import Hero from "../components/ds/Hero.astro";
import Prose from "../components/ds/Prose.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { resolveSiteIdentity } from "../utils/site";

const slug = decodeSlug(Astro.params.slug);

if (!slug) {
	return Astro.redirect("/404");
}

const { entry: page, cacheHint } = await getEmDashEntry("pages", slug);

if (!page) {
	return Astro.redirect("/404");
}

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);
const { siteTitle } = resolveSiteIdentity(await getSiteSettings());

const seo = getSeoMeta(page, {
	siteTitle,
	siteUrl: Astro.url.origin,
	path: Astro.url.pathname.replace(/\/$/, ""),
});

const summary = page.data.summary ? String(page.data.summary) : null;
---

<BaseLayout
	title={seo.title}
	pageTitle={seo.ogTitle}
	description={seo.description}
	canonical={seo.canonical}
	content={{ collection: "pages", id: page.data.id, slug }}
>
	<Hero
		slot="hero"
		variant="compact"
		title={String(page.data.title)}
		lead={summary}
		breadcrumbs={[{ label: "Home", href: "/" }, { label: String(page.data.title) }]}
	/>

	<Prose>
		<PortableText value={page.data.content} />
	</Prose>
</BaseLayout>
