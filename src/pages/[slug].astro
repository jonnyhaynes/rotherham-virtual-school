---
import {
	decodeSlug,
	getEmDashEntry,
	getSeoMeta,
	getSiteSettings,
} from "emdash";
import { PortableText } from "emdash/ui";
import BaseLayout from "../layouts/BaseLayout.astro";
import { resolveSiteIdentity } from "../utils/site";

const slug = decodeSlug(Astro.params.slug);

if (!slug) {
	return Astro.redirect("/404");
}

const { entry: page, cacheHint } = await getEmDashEntry("pages", slug);

if (!page) {
	return Astro.redirect("/404");
}

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);
const { siteTitle } = resolveSiteIdentity(await getSiteSettings());

const seo = getSeoMeta(page, {
	siteTitle,
	siteUrl: Astro.url.origin,
	path: Astro.url.pathname.replace(/\/$/, ""),
});
---

<BaseLayout
	title={seo.title}
	pageTitle={seo.ogTitle}
	description={seo.description}
	canonical={seo.canonical}
	content={{ collection: "pages", id: page.data.id, slug }}
	breadcrumbs={[{ label: "Home", href: "/" }, { label: page.data.title }]}
>
	<h1 class="govuk-heading-xl" {...page.edit.title}>{page.data.title}</h1>

	<div class="rvs-prose">
		<PortableText value={page.data.content} />
	</div>
</BaseLayout>
