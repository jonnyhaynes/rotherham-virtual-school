---
/**
 * "Is this page useful?" feedback, following the pattern GOV.UK uses at the
 * foot of its content pages.
 *
 * The band itself (top border, background, gutter padding) comes from the
 * Design System's `govuk-feedback` component. The internal geometry mirrors
 * GOV.UK's own feedback component: on desktop the question and Yes/No sit on
 * the left with "Report a problem with this page" pushed to the right, and the
 * whole band is pulled out to the full width so it meets the footer flush.
 *
 * TODO before launch: submissions currently only reach the server log. The
 * endpoint in src/pages/api/feedback.ts needs a real destination (an inbox or a
 * form service) before this is shown to the public.
 */
interface Props {
	title?: string;
}

const { title = "Is this page useful?" } = Astro.props;
const pageUrl = Astro.url.pathname;
---

<div class="govuk-feedback rvs-feedback">
	<div class="rvs-feedback__prompt-content">
		<div class="rvs-feedback__prompt-questions" data-feedback-prompt>
			<h2 class="govuk-heading-s rvs-feedback__prompt-question">{title}</h2>
			<ul class="rvs-feedback__option-list">
				<li class="rvs-feedback__option-list-item">
					<button type="button" class="rvs-feedback__prompt-link" data-feedback="useful">
						Yes<span class="govuk-visually-hidden">, this page is useful</span>
					</button>
				</li>
				<li class="rvs-feedback__option-list-item">
					<button
						type="button"
						class="rvs-feedback__prompt-link"
						data-feedback="not-useful"
						aria-controls="rvs-feedback-form"
						aria-expanded="false"
					>
						No<span class="govuk-visually-hidden">, this page is not useful</span>
					</button>
				</li>
			</ul>
		</div>

		<div class="rvs-feedback__prompt-questions rvs-feedback__prompt-questions--report">
			<button
				type="button"
				class="rvs-feedback__prompt-link"
				data-feedback="report"
				aria-controls="rvs-feedback-form"
				aria-expanded="false"
			>
				Report a problem with this page
			</button>
		</div>
	</div>

	<p class="govuk-heading-s rvs-feedback__prompt-success" data-feedback-thanks role="alert" hidden>
		Thank you for your feedback
	</p>

	<form
		class="rvs-feedback__form"
		id="rvs-feedback-form"
		method="post"
		action="/api/feedback"
		hidden
	>
		<input type="hidden" name="url" value={pageUrl} />

		{/* Honeypot: hidden from people, irresistible to bots. */}
		<div class="govuk-visually-hidden" aria-hidden="true">
			<label for="rvs-feedback-website">Leave this field blank</label>
			<input
				id="rvs-feedback-website"
				name="website"
				type="text"
				tabindex="-1"
				autocomplete="off"
			/>
		</div>

		<h2 class="govuk-heading-m">Help us improve this page</h2>
		<p class="govuk-body">
			Do not include personal or financial information, for example a National Insurance number
			or credit card details.
		</p>

		<div class="govuk-form-group" data-feedback-group>
			<label class="govuk-label" for="rvs-feedback-message">What were you doing?</label>
			<p class="govuk-error-message" id="rvs-feedback-message-error" data-feedback-error hidden></p>
			<textarea
				class="govuk-textarea"
				id="rvs-feedback-message"
				name="message"
				rows="5"></textarea>
		</div>

		<button type="submit" class="govuk-button">Send</button>

		<p class="govuk-visually-hidden" role="status" data-feedback-status></p>
	</form>
</div>

<script is:inline>
	(function () {
		var script = document.currentScript;
		var root = script ? script.closest(".rvs-feedback") : null;
		if (!root) root = document.querySelector(".rvs-feedback");
		if (!root) return;

		var prompt = root.querySelector("[data-feedback-prompt]");
		var report = root.querySelector(".rvs-feedback__prompt-questions--report");
		var thanks = root.querySelector("[data-feedback-thanks]");
		var form = root.querySelector("#rvs-feedback-form");
		var triggers = root.querySelectorAll('[data-feedback="not-useful"], [data-feedback="report"]');
		var yesButton = root.querySelector('[data-feedback="useful"]');
		var group = root.querySelector("[data-feedback-group]");
		var error = root.querySelector("[data-feedback-error]");
		var status = root.querySelector("[data-feedback-status]");
		var field = root.querySelector("#rvs-feedback-message");

		// The success text is set rather than assumed: a failed send used to
		// overwrite this element, so a later success showed the failure message
		// as the confirmation.
		function showThanks() {
			if (prompt) prompt.hidden = true;
			if (report) report.hidden = true;
			if (form) form.hidden = true;
			if (thanks) {
				thanks.textContent = "Thank you for your feedback";
				thanks.hidden = false;
			}
		}

		function showError(message) {
			if (!error || !group || !field) return;
			error.textContent = "";
			var prefix = document.createElement("span");
			prefix.className = "govuk-visually-hidden";
			prefix.textContent = "Error: ";
			error.appendChild(prefix);
			error.appendChild(document.createTextNode(message));
			error.hidden = false;
			group.classList.add("govuk-form-group--error");
			field.classList.add("govuk-textarea--error");
			field.setAttribute("aria-describedby", "rvs-feedback-message-error");
		}

		function clearError() {
			if (!error || !group || !field) return;
			error.hidden = true;
			error.textContent = "";
			group.classList.remove("govuk-form-group--error");
			field.classList.remove("govuk-textarea--error");
			field.removeAttribute("aria-describedby");
		}

		function showForm() {
			if (!form) return;
			form.hidden = false;
			triggers.forEach(function (trigger) {
				trigger.setAttribute("aria-expanded", "true");
			});
			if (field) field.focus();
		}

		if (yesButton) {
			yesButton.addEventListener("click", showThanks);
		}

		triggers.forEach(function (trigger) {
			trigger.addEventListener("click", showForm);
		});

		if (field) {
			field.addEventListener("input", clearError);
		}

		if (form) {
			form.addEventListener("submit", function (event) {
				event.preventDefault();
				var button = form.querySelector('button[type="submit"]');

				// Submitted empty: say what is missing and put the cursor there,
				// rather than sending a request the server will reject with a
				// message this page then threw away.
				if (field && field.value.trim() === "") {
					showError("Enter what you were doing before you send.");
					field.focus();
					return;
				}

				clearError();
				if (button) {
					button.disabled = true;
					button.setAttribute("aria-busy", "true");
				}
				if (status) status.textContent = "Sending your feedback";

				// A request that never comes back used to leave the button
				// disabled for good, with no way out. The abort resolves it into
				// the failure path so the user can try again.
				var controller = new AbortController();
				var timer = window.setTimeout(function () {
					controller.abort();
				}, 15000);

				function settle() {
					window.clearTimeout(timer);
					if (button) {
						button.disabled = false;
						button.removeAttribute("aria-busy");
					}
					if (status) status.textContent = "";
				}

				fetch(form.action, {
					method: "POST",
					headers: { "content-type": "application/json", accept: "application/json" },
					signal: controller.signal,
					body: JSON.stringify({
						url: form.querySelector('[name="url"]').value,
						website: form.querySelector('[name="website"]').value,
						message: field ? field.value : "",
					}),
				})
					.then(function (response) {
						if (response.ok) {
							settle();
							showThanks();
							return null;
						}
						// The API answers validation failures with the reason. Show
						// that against the field so the user knows what to change.
						return response
							.json()
							.catch(function () {
								return {};
							})
							.then(function (body) {
								throw new Error(body && body.error ? body.error : "");
							});
					})
					.catch(function (failure) {
						settle();
						var timedOut = failure && failure.name === "AbortError";
						var reason = !timedOut && failure && failure.message ? failure.message : "";
						if (reason) {
							showError(reason);
							if (field) field.focus();
						} else if (thanks) {
							thanks.textContent = timedOut
								? "That took too long to send. Check your connection and try again."
								: "Sorry, there was a problem sending your feedback. Please try again.";
							thanks.hidden = false;
						}
					});
			});
		}
	})();
</script>

<style>
	/* Pulled out to the full width so the band meets the footer flush, matching
	   GOV.UK's own feedback component. */
	.rvs-feedback {
		margin: 30px -15px 0;
		padding-bottom: 20px;
	}

	@media (min-width: 40.0625em) {
		.rvs-feedback {
			margin-top: 60px;
			margin-right: -30px;
			margin-left: -30px;
			padding-bottom: 30px;
		}
	}

	.rvs-feedback [hidden] {
		display: none !important;
	}

	/* Stacked on small screens, two columns with the report action on the right
	   from tablet up. */
	.rvs-feedback__prompt-content {
		display: flex;
		flex-direction: column;
		padding: 0 15px;
	}

	@media (min-width: 40.0625em) {
		.rvs-feedback__prompt-content {
			flex-direction: row;
			align-items: center;
			justify-content: space-between;
			padding: 0 30px;
		}
	}

	.rvs-feedback__prompt-questions {
		padding: 20px 0;
		text-align: left;
	}

	.rvs-feedback__prompt-questions:not(:first-child) {
		border-top: 1px solid var(--rvs-border);
	}

	@media (min-width: 40.0625em) {
		.rvs-feedback__prompt-questions {
			margin: 0;
			padding: 20px 0;
		}

		.rvs-feedback__prompt-questions:not(:first-child) {
			border-top: 0;
		}
	}

	.rvs-feedback__prompt-question {
		margin: 0;
		padding-bottom: 10px;
	}

	@media (min-width: 40.0625em) {
		.rvs-feedback__prompt-question {
			padding-bottom: 0;
			margin-right: 20px;
			display: inline-block;
		}
	}

	.rvs-feedback__option-list {
		display: flex;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	@media (min-width: 40.0625em) {
		.rvs-feedback__option-list {
			display: inline-flex;
			vertical-align: middle;
		}
	}

	.rvs-feedback__option-list-item:last-child {
		margin-left: 20px;
	}

	/* GOV.UK's feedback buttons: square, outlined, with the 3px button shadow. */
	.rvs-feedback__prompt-link {
		min-width: 80px;
		margin-bottom: 0;
		font-size: 1.1875rem;
		line-height: 1.3;
		color: var(--rvs-ink);
		background: transparent;
		border: 1px solid var(--rvs-ink);
		box-shadow: 0 3px 0 var(--rvs-ink);
		padding: 8px 10px;
		/* These are the page's primary feedback controls; keep them a
		   comfortable touch target rather than a cursor-sized one. */
		min-height: 44px;
		cursor: pointer;
	}

	.rvs-feedback__prompt-link:hover {
		background: #fff;
	}

	.rvs-feedback__prompt-link:focus {
		outline: 3px solid transparent;
		color: var(--rvs-ink);
		background-color: var(--rvs-yellow);
		box-shadow:
			0 -2px var(--rvs-yellow),
			0 4px var(--rvs-ink);
		text-decoration: none;
	}

	.rvs-feedback__prompt-success {
		margin: 0;
		padding: 20px 15px;
	}

	@media (min-width: 40.0625em) {
		.rvs-feedback__prompt-success {
			padding: 20px 30px;
		}
	}

	.rvs-feedback__form {
		padding: 15px;
	}

	@media (min-width: 40.0625em) {
		.rvs-feedback__form {
			padding: 30px 30px 0;
		}
	}

	/* Sending: the button disables while the request is in flight and keeps its
	   "Send" label, with a spinner so a slow connection does not look like a
	   dead button. `role="status"` announces the same thing to a screen reader,
	   because a disabled button says nothing on its own. */
	.rvs-feedback__form .govuk-button[aria-busy="true"]::after {
		content: "";
		display: inline-block;
		width: 1em;
		height: 1em;
		margin-left: 10px;
		vertical-align: -2px;
		border: 3px solid currentColor;
		border-right-color: transparent;
		border-radius: 50%;
		animation: rvs-feedback-spin 0.7s linear infinite;
	}

	@keyframes rvs-feedback-spin {
		to {
			transform: rotate(360deg);
		}
	}

	/* A rotating indicator is motion, so it gets an authored alternative: the
	   ring stays as a static busy mark, the rotation stops. */
	@media (prefers-reduced-motion: reduce) {
		.rvs-feedback__form .govuk-button[aria-busy="true"]::after {
			animation: none;
		}
	}
</style>
