---
import Icon from "./Icon.astro";

/**
 * Pagination — numbered or previous/next. Ported from `bundle.js`. `hrefFor`
 * builds each page's URL so the links work without JavaScript.
 */
interface Props {
	page?: number;
	total?: number;
	hrefFor?: (page: number) => string;
	variant?: "numbered" | "prev-next";
	prev?: { label: string; href: string } | null;
	next?: { label: string; href: string } | null;
	label?: string;
	class?: string;
}

const {
	page = 1,
	total = 1,
	hrefFor = (p: number) => `?page=${p}`,
	variant = "numbered",
	prev = null,
	next = null,
	label = "Results pages",
	class: className,
} = Astro.props;

function pageList(current: number, count: number): (number | "…")[] {
	const out: (number | "…")[] = [];
	if (count <= 7) {
		for (let i = 1; i <= count; i++) out.push(i);
		return out;
	}
	out.push(1);
	if (current > 3) out.push("…");
	for (let i = Math.max(2, current - 1); i <= Math.min(count - 1, current + 1); i++) out.push(i);
	if (current < count - 2) out.push("…");
	out.push(count);
	return out;
}
---

{
	variant === "prev-next" ? (
		<nav class:list={["rvs-pagination", "rvs-pagination--block", className]} aria-label={label}>
			{prev ? (
				<a class="rvs-pagination__block" href={prev.href} rel="prev">
					<span class="rvs-pagination__dir"><Icon name="arrow-left" size={20} />Previous</span>
					<span class="rvs-pagination__label">{prev.label}</span>
				</a>
			) : (
				<span />
			)}
			{next && (
				<a class="rvs-pagination__block rvs-pagination__block--next" href={next.href} rel="next">
					<span class="rvs-pagination__dir">Next<Icon name="arrow-right" size={20} /></span>
					<span class="rvs-pagination__label">{next.label}</span>
				</a>
			)}
		</nav>
	) : total <= 1 ? null : (
		<nav class:list={["rvs-pagination", className]} aria-label={label}>
			{page > 1 && (
				<a class="rvs-pagination__prev" href={hrefFor(page - 1)} rel="prev">
					<Icon name="arrow-left" size={18} />
					<span>Previous<span class="rvs-visually-hidden"> page</span></span>
				</a>
			)}
			<ul class="rvs-pagination__list">
				{pageList(page, total).map((p) =>
					p === "…" ? (
						<li class="rvs-pagination__ellipsis" aria-hidden="true">…</li>
					) : (
						<li>
							<a
								class:list={["rvs-pagination__num", p === page && "is-current"]}
								href={hrefFor(p)}
								aria-current={p === page ? "page" : undefined}
								aria-label={`Page ${p}`}
							>
								{p}
							</a>
						</li>
					),
				)}
			</ul>
			{page < total && (
				<a class="rvs-pagination__next" href={hrefFor(page + 1)} rel="next">
					<span>Next<span class="rvs-visually-hidden"> page</span></span>
					<Icon name="arrow-right" size={18} />
				</a>
			)}
		</nav>
	)
}
