---
import Logo from "./Logo.astro";

/**
 * Footer — the single site footer on navy. Ported from `bundle.js`, laid out so
 * it reads as one band rather than two:
 *
 *   - the top row is four columns: the mark, then the three navigation columns;
 *   - the support links and the council partner sit in a thin bottom bar;
 *   - the copyright closes it, with the house colophon beneath.
 *
 * The design system's reference footer carries only the support links; this
 * service's footer has always carried its navigation in columns, so that is kept
 * as a site extension. Two things are not part of the design system and are
 * supplied by the site: the Rotherham Metropolitan Borough Council logo goes in
 * the `partner` slot, and the Colouring Code house credit goes in the `credit`
 * slot, which sits below the copyright so the credit ends the page.
 */
interface Group {
	heading: string;
	links: { label: string; href: string }[];
}

interface Props {
	/** The footer's navigation columns. */
	navigationGroups?: Group[];
	/** Keep to support pages: accessibility, privacy, cookies, contact. */
	links?: { label: string; href: string }[];
	copyright?: string;
	logoHref?: string;
	class?: string;
}

const {
	navigationGroups = [],
	links = [],
	copyright,
	logoHref = "/",
	class: className,
} = Astro.props;

const year = new Date().getFullYear();
const resolvedCopyright =
	copyright ?? `© ${year} Rotherham Virtual School. All rights reserved.`;
---

<footer class:list={["rvs-footer", className]}>
	<div class="rvs-footer__inner">
		<div class="rvs-footer__top">
			{/*
				The mark alone, not the design system's stacked lock-up: at this
				size the name would dominate the band, and it is already on the
				page in the navigation and the copyright. Reversed for navy.
			*/}
			<Logo variant="mark" reversed={true} height={96} href={logoHref} />

			{
				navigationGroups.length > 0 && (
					<nav class="rvs-footer__nav" aria-label="Footer">
						{navigationGroups.map((group) => (
							<div class="rvs-footer__section">
								<h2 class="rvs-footer__heading">{group.heading}</h2>
								<ul class="rvs-footer__list">
									{group.links.map((link) => (
										<li>
											<a class="rvs-footer__link" href={link.href}>
												{link.label}
											</a>
										</li>
									))}
								</ul>
							</div>
						))}
					</nav>
				)
			}
		</div>

		<div class="rvs-footer__bottom">
			{
				links.length > 0 && (
					<nav aria-label="Support links">
						<ul class="rvs-footer__links">
							{links.map((link) => (
								<li>
									<a class="rvs-footer__link" href={link.href}>
										{link.label}
									</a>
								</li>
							))}
						</ul>
					</nav>
				)
			}
			{
				Astro.slots.has("partner") && (
					<div class="rvs-footer__partner">
						<slot name="partner" />
					</div>
				)
			}
		</div>

		{
			Astro.slots.has("default") && (
				<div class="rvs-footer__extra">
					<slot />
				</div>
			)
		}

		<p class="rvs-footer__meta">{resolvedCopyright}</p>

		{
			Astro.slots.has("credit") && (
				<p class="rvs-footer__credit">
					<slot name="credit" />
				</p>
			)
		}
	</div>
</footer>
