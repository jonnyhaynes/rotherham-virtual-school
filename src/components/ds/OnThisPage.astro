---
import { uid } from "./assets";

/**
 * OnThisPage — a table of contents for a long page. Ported from `bundle.js`.
 *
 * `trackActive` highlights the section in view; without JavaScript the list is a
 * plain set of in-page links. The heading id is generated so more than one
 * instance on a page stays valid.
 */
interface Props {
	items: { id: string; label: string }[];
	heading?: string;
	sticky?: boolean;
	trackActive?: boolean;
	class?: string;
}

const {
	items = [],
	heading = "On this page",
	sticky = false,
	trackActive = false,
	class: className,
} = Astro.props;

const headingId = uid("rvs-toc-h");
---

<nav
	class:list={["rvs-toc", sticky && "rvs-toc--sticky", className]}
	aria-labelledby={headingId}
	data-rvs-toc
	data-track={trackActive ? "true" : undefined}
>
	<h2 id={headingId} class="rvs-toc__title">{heading}</h2>
	<ol class="rvs-toc__list">
		{items.map((item) => (
			<li class="rvs-toc__item" data-rvs-toc-item data-target={item.id}>
				<a href={`#${item.id}`}>{item.label}</a>
			</li>
		))}
	</ol>
</nav>

<script>
	document.querySelectorAll<HTMLElement>("[data-rvs-toc]").forEach((toc) => {
		if (toc.dataset.track !== "true" || typeof IntersectionObserver === "undefined") return;
		const items = Array.from(toc.querySelectorAll<HTMLElement>("[data-rvs-toc-item]"));
		const byId = new Map(items.map((item) => [item.dataset.target, item]));
		const setActive = (id: string) => {
			items.forEach((item) => {
				const on = item.dataset.target === id;
				item.classList.toggle("is-active", on);
				item.querySelector("a")?.setAttribute("aria-current", on ? "location" : "");
			});
		};
		const observer = new IntersectionObserver(
			(entries) => {
				entries.forEach((entry) => {
					if (entry.isIntersecting) setActive(entry.target.id);
				});
			},
			{ rootMargin: "0px 0px -70% 0px" },
		);
		byId.forEach((_item, id) => {
			const el = id ? document.getElementById(id) : null;
			if (el) observer.observe(el);
		});
	});
</script>
