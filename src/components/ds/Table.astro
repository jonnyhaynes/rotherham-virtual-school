---
import Icon from "./Icon.astro";

/**
 * Table — a data or comparison table. Ported from `bundle.js`.
 *
 * A boolean cell renders a tick or a dash, each with a word for assistive
 * technology, so meaning never rests on colour. The wrapper is a focusable
 * region so a keyboard user can scroll a wide table.
 */
interface Column {
	key: string;
	label: string;
	numeric?: boolean;
}

interface Props {
	columns: Column[];
	rows: Record<string, string | boolean>[];
	caption?: string | null;
	variant?: "default" | "comparison";
	striped?: boolean;
	firstColumnHeader?: boolean;
	class?: string;
}

const {
	columns = [],
	rows = [],
	caption = null,
	variant = "default",
	striped = false,
	firstColumnHeader = true,
	class: className,
} = Astro.props;
---

<div class:list={["rvs-table-wrap", className]} role="region" aria-label={caption ?? undefined} tabindex="0">
	<table
		class:list={[
			"rvs-table",
			variant === "comparison" && "rvs-table--comparison",
			striped && "rvs-table--striped",
		]}
	>
		{caption && <caption class="rvs-table__caption">{caption}</caption>}
		<thead>
			<tr>
				{columns.map((col) => <th scope="col" class={col.numeric ? "is-num" : undefined}>{col.label}</th>)}
			</tr>
		</thead>
		<tbody>
			{
				rows.map((row) => (
					<tr>
						{columns.map((col, j) => {
							const value = row[col.key];
							const cell =
								value === true ? (
									<>
										<Icon name="check" size={20} class="rvs-tone-text-success" />
										<span class="rvs-visually-hidden">Yes</span>
									</>
								) : value === false ? (
									<>
										<span aria-hidden="true" class="rvs-muted">—</span>
										<span class="rvs-visually-hidden">No</span>
									</>
								) : (
									value
								);
							return j === 0 && firstColumnHeader ? (
								<th scope="row">{cell}</th>
							) : (
								<td class={col.numeric ? "is-num" : undefined}>{cell}</td>
							);
						})}
					</tr>
				))
			}
		</tbody>
	</table>
</div>
