---
import { SITE_DEFAULTS } from "../utils/site";

interface Props {
	heading?: string;
	/** Optional extra sentence tailored to the page. */
	text?: string;
}

const {
	heading = "Ask the Virtual School",
	text = "If you are not sure who to talk to, contact the Virtual School team and we will point you in the right direction.",
} = Astro.props;
---

<aside class="rvs-contact-panel" aria-labelledby="rvs-contact-heading">
	<h2 class="govuk-heading-m" id="rvs-contact-heading">{heading}</h2>
	<p class="govuk-body">{text}</p>
	<ul class="govuk-list rvs-contact-panel__list" role="list">
		<li>
			Email
			<a class="govuk-link rvs-break-words" href={`mailto:${SITE_DEFAULTS.email}`}
				>{SITE_DEFAULTS.email}</a
			>
		</li>
		<li><a class="govuk-link" href="/contact/">All contact details and who's who</a></li>
	</ul>
</aside>

<style>
	.rvs-contact-panel {
		background: #fff;
		border-left: 10px solid var(--rvs-audience-parent);
		padding: 1.25rem;
		outline: 1px solid var(--rvs-border);
		outline-offset: -1px;
	}

	.rvs-contact-panel h2 {
		margin-top: 0;
	}

	.rvs-contact-panel__list {
		margin: 0;
		padding-left: 1.25rem;
	}
</style>
