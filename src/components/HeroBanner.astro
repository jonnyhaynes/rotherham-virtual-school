---
/**
 * Full-bleed photographic hero, mirroring Rotherham.gov.uk's service headers.
 * Falls back to a Rotherham navy/sky gradient when no photograph is supplied,
 * so the page never depends on an image being present.
 *
 * Type comes from the GOV.UK scale (`govuk-heading-xl` / `govuk-body-l`) rather
 * than bespoke sizes, and this file only overrides what the dark surface needs.
 */
interface Props {
	title: string;
	lead?: string;
	imageSrc?: string;
	imageAlt?: string;
}

const { title, lead, imageSrc, imageAlt = "" } = Astro.props;
---

<section class="rvs-hero">
	{
		imageSrc && (
			<img class="rvs-hero__image" src={imageSrc} alt={imageAlt} loading="eager" />
		)
	}
	<div class="rvs-hero__inner">
		<div class="govuk-width-container">
			<h1 class="govuk-heading-xl rvs-hero__title">{title}</h1>
			{lead && <p class="govuk-body-l rvs-hero__lead">{lead}</p>}
		</div>
	</div>
</section>

<style>
	.rvs-hero {
		position: relative;
		background: linear-gradient(135deg, #002554 0%, #0052ba 70%, #66cbf3 100%);
		color: #fff;
		isolation: isolate;
	}

	.rvs-hero__image {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		z-index: -2;
	}

	/* Keeps the heading legible over any photograph. */
	.rvs-hero__inner {
		position: relative;
		background: linear-gradient(
			90deg,
			rgba(0, 19, 43, 0.88) 0%,
			rgba(0, 19, 43, 0.7) 55%,
			rgba(0, 19, 43, 0.35) 100%
		);
		padding: 40px 0;
	}

	/* Light type on a dark ground reads optically thinner and brighter than the
	   same size on white, so both blocks get more line-height and a trace of
	   letter-spacing than the GOV.UK defaults. */
	.rvs-hero__title {
		margin: 0;
		max-width: 30ch;
		color: #fff;
		line-height: 1.15;
		letter-spacing: 0.01em;
	}

	.rvs-hero__lead {
		margin: 20px 0 0;
		/* Capped inside the 60–75ch readable band. */
		max-width: 65ch;
		color: #fff;
		line-height: 1.5;
		letter-spacing: 0.01em;
		text-wrap: pretty;
	}

	@media (min-width: 40.0625em) {
		.rvs-hero__inner {
			padding: 60px 0;
		}
	}
</style>
