---
/**
 * Full-bleed photographic hero, mirroring Rotherham.gov.uk's service headers.
 * Falls back to a Rotherham navy/sky gradient when no photograph is supplied,
 * so the page never depends on an image being present.
 *
 * Type comes from the GOV.UK scale (`govuk-heading-xl` / `govuk-body-l`) rather
 * than bespoke sizes, and this file only overrides what the dark surface needs.
 */
interface Props {
	title: string;
	lead?: string;
	imageSrc?: string;
	imageAlt?: string;
}

const { title, lead, imageSrc, imageAlt = "" } = Astro.props;
---

<section class="rvs-hero">
	{
		imageSrc && (
			<img class="rvs-hero__image" src={imageSrc} alt={imageAlt} loading="eager" />
		)
	}
	<div class="rvs-hero__inner">
		<div class="govuk-width-container">
			<h1 class="govuk-heading-xl rvs-hero__title">{title}</h1>
			{lead && <p class="govuk-body-l rvs-hero__lead">{lead}</p>}
		</div>
	</div>
</section>

<style>
	/* The band's own gradient, with the legibility scrim layered over it along
	   the same 135° axis. The scrim used to run horizontally while the base ran
	   diagonally, so the bottom corner got the least scrim and the lightest base
	   at once and showed as a pale wedge. Sharing the axis keeps the darkening
	   proportional at every point, which leaves the sky accent readable at the
	   far corner (6.3:1 against white) and 12.5:1 where the lead sits. */
	.rvs-hero {
		position: relative;
		background:
			linear-gradient(
				135deg,
				rgba(0, 19, 43, 0.94) 0%,
				rgba(0, 19, 43, 0.86) 45%,
				rgba(0, 19, 43, 0.55) 100%
			),
			linear-gradient(135deg, var(--rvs-navy) 0%, #0052ba 60%, #66cbf3 100%);
		color: #fff;
		isolation: isolate;
	}

	.rvs-hero__image {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		z-index: -2;
	}

	.rvs-hero__inner {
		position: relative;
		padding-block: var(--rvs-space-8);
	}

	/* Light type on a dark ground reads optically thinner and brighter than the
	   same size on white, so both blocks get more line-height and a trace of
	   letter-spacing than the GOV.UK defaults. */
	.rvs-hero__title {
		margin: 0;
		max-width: 54rem;
		color: #fff;
		line-height: 1.15;
		letter-spacing: 0.01em;
	}

	.rvs-hero__lead {
		margin: var(--rvs-space-4) 0 0;
		/* 58rem is 928px, roughly 65ch at 24px. Fixed width rather than ch so the
		   measure cannot change with the font and reflow the hero on load. */
		max-width: 58rem;
		color: #fff;
		line-height: 1.5;
		letter-spacing: 0.01em;
		text-wrap: pretty;
	}

	@media (min-width: 40.0625em) {
		.rvs-hero__inner {
			padding-block: 60px;
		}
	}
</style>
