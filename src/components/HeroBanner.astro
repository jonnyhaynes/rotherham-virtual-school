---
/**
 * Full-bleed photographic hero, mirroring Rotherham.gov.uk's service headers.
 * Falls back to a Rotherham navy/sky gradient when no photograph is supplied,
 * so the page never depends on an image being present.
 */
interface Props {
	title: string;
	lead?: string;
	imageSrc?: string;
	imageAlt?: string;
}

const { title, lead, imageSrc, imageAlt = "" } = Astro.props;
---

<section class="rvs-hero">
	{
		imageSrc && (
			<img class="rvs-hero__image" src={imageSrc} alt={imageAlt} loading="eager" />
		)
	}
	<div class="rvs-hero__inner">
		<div class="govuk-width-container">
			<h1 class="rvs-hero__title">{title}</h1>
			{lead && <p class="rvs-hero__lead">{lead}</p>}
		</div>
	</div>
</section>

<style>
	.rvs-hero {
		position: relative;
		background: linear-gradient(135deg, #002554 0%, #0052ba 70%, #66cbf3 100%);
		color: #fff;
		isolation: isolate;
	}

	.rvs-hero__image {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		z-index: -2;
	}

	/* Keeps the heading legible over any photograph. */
	.rvs-hero__inner {
		position: relative;
		background: linear-gradient(
			90deg,
			rgba(0, 19, 43, 0.88) 0%,
			rgba(0, 19, 43, 0.7) 55%,
			rgba(0, 19, 43, 0.35) 100%
		);
		padding: 2.5rem 0;
	}

	.rvs-hero__title {
		margin: 0;
		color: #fff;
		font-size: 2.25rem;
		line-height: 1.1;
		max-width: 30ch;
	}

	.rvs-hero__lead {
		margin: 1rem 0 0;
		max-width: 60ch;
		font-size: 1.25rem;
		line-height: 1.4;
	}

	@media (min-width: 40.0625em) {
		.rvs-hero__inner {
			padding: 4rem 0;
		}

		.rvs-hero__title {
			font-size: 3rem;
		}
	}
</style>
