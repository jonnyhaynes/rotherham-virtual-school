---
interface Props {
	title: string;
	href: string;
	summary?: string | null;
	/** EmDash datetime fields arrive as ISO strings. */
	startsAt?: string | Date | null;
	endsAt?: string | Date | null;
	location?: string | null;
	isOnline?: boolean | null;
}

const { title, href, summary, startsAt, endsAt, location, isOnline } =
	Astro.props;

const start = startsAt ? new Date(startsAt) : null;
const end = endsAt ? new Date(endsAt) : null;

const dateLabel = start
	? start.toLocaleDateString("en-GB", {
			weekday: "long",
			day: "numeric",
			month: "long",
			year: "numeric",
		})
	: null;

const timeLabel =
	start && end
		? `${start.toLocaleTimeString("en-GB", { hour: "2-digit", minute: "2-digit" })} to ${end.toLocaleTimeString("en-GB", { hour: "2-digit", minute: "2-digit" })}`
		: start
			? start.toLocaleTimeString("en-GB", { hour: "2-digit", minute: "2-digit" })
			: null;
---

<li class="rvs-event-card">
	<h3 class="govuk-heading-m rvs-event-card__title">
		<a class="govuk-link" href={href}>{title}</a>
	</h3>
	{summary && <p class="govuk-body rvs-event-card__summary">{summary}</p>}
	<dl class="rvs-event-card__details">
		{
			dateLabel && (
				<>
					<dt>Date</dt>
					<dd>
						<time datetime={start?.toISOString()}>{dateLabel}</time>
						{timeLabel && <>, {timeLabel}</>}
					</dd>
				</>
			)
		}
		{
			(location || isOnline) && (
				<>
					<dt>Where</dt>
					<dd>{isOnline ? `Online${location ? ` — ${location}` : ""}` : location}</dd>
				</>
			)
		}
	</dl>
</li>

<style>
	.rvs-event-card {
		border-top: 4px solid var(--rvs-audience-school);
		padding: 1rem 0 0;
	}

	.rvs-event-card__title {
		margin: 0 0 0.5rem;
	}

	.rvs-event-card__summary {
		margin: 0 0 0.75rem;
	}

	.rvs-event-card__details {
		margin: 0;
	}

	.rvs-event-card__details dt {
		font-weight: 700;
	}

	.rvs-event-card__details dd {
		margin: 0 0 0.25rem;
	}
</style>
