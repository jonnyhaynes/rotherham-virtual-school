---
/**
 * Search form, following GOV.UK's search component: a label, an input with a
 * 2px border, and a square submit button attached flush to the input's right.
 *
 * Submits a GET to /search so it works without JavaScript.
 */
interface Props {
	label?: string;
	value?: string;
	/** Input id, so the label associates correctly when several forms exist. */
	inputId?: string;
}

const {
	label = "Search Rotherham Virtual School",
	value = "",
	inputId = "rvs-search-input",
} = Astro.props;
---

<form class="rvs-search" action="/search" method="get" role="search">
	<label class="govuk-label rvs-search__label" for={inputId}>{label}</label>
	<div class="rvs-search__item-wrapper">
		<input
			class="rvs-search__input"
			id={inputId}
			name="q"
			type="search"
			value={value}
			autocorrect="off"
			autocapitalize="off"
		/>
		<div class="rvs-search__submit-wrapper">
			<button class="rvs-search__submit" type="submit">
				<span class="govuk-visually-hidden">Search</span>
				<svg
					class="rvs-search__icon"
					width="27"
					height="27"
					viewBox="0 0 27 27"
					fill="none"
					xmlns="http://www.w3.org/2000/svg"
					aria-hidden="true"
					focusable="false"
				>
					<circle
						cx="12.0161"
						cy="11.0161"
						r="8.51613"
						stroke="currentColor"
						stroke-width="3"></circle>
					<line
						x1="17.8668"
						y1="17.3587"
						x2="26.4475"
						y2="25.9393"
						stroke="currentColor"
						stroke-width="3"></line>
				</svg>
			</button>
		</div>
	</div>
</form>

<style>
	.rvs-search__label {
		margin-bottom: 5px;
	}

	.rvs-search__item-wrapper {
		display: table;
		width: 100%;
		max-width: 40rem;
		background: #fff;
	}

	.rvs-search__input {
		display: table-cell;
		box-sizing: border-box;
		width: 100%;
		height: 2.5rem;
		margin: 0;
		padding: 0 0.5rem;
		border: 2px solid var(--rvs-ink);
		border-right: 0;
		border-radius: 0;
		background: #fff;
		font-family: inherit;
		/*
		 * GOV.UK's input size. Without this the field inherits the 16px root
		 * font and reads smaller than the body copy beside it.
		 */
		font-size: 1.1875rem;
	}

	.rvs-search__input:focus {
		position: relative;
		z-index: 2;
		outline: 3px solid transparent;
		box-shadow: inset 0 0 0 2px;
		background-color: var(--rvs-yellow);
	}

	.rvs-search__submit-wrapper {
		display: table-cell;
		width: 1%;
		vertical-align: top;
	}

	.rvs-search__submit {
		position: relative;
		width: 2.5rem;
		height: 2.5rem;
		padding: 0;
		border: 0;
		border-radius: 0;
		background-color: var(--rvs-navy);
		color: #fff;
		cursor: pointer;
		overflow: hidden;
	}

	.rvs-search__submit:hover {
		background-color: #001a3e;
	}

	.rvs-search__submit:focus {
		outline: 3px solid transparent;
		box-shadow: inset 0 0 0 2px var(--rvs-yellow);
	}

	.rvs-search__icon {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		transform: scale(0.5);
		pointer-events: none;
	}
</style>
