---
interface Props {
	title: string;
	href: string;
	summary?: string | null;
	/** EmDash datetime fields arrive as ISO strings. */
	publishedOn?: string | Date | null;
	/**
	 * Heading level for the card title. The card sits directly under the page
	 * heading on the news index and under a section heading on the home page, so
	 * it cannot hardcode one level without skipping a rank somewhere.
	 */
	level?: 2 | 3;
}

const { title, href, summary, publishedOn, level = 3 } = Astro.props;
const Heading = `h${level}`;

const published = publishedOn ? new Date(publishedOn) : null;
const dateLabel = published
	? published.toLocaleDateString("en-GB", {
			day: "numeric",
			month: "long",
			year: "numeric",
		})
	: null;
---

<li class="rvs-news-card">
	{dateLabel && (
		<time class="govuk-body-s rvs-news-card__date" datetime={published?.toISOString()}>
			{dateLabel}
		</time>
	)}
	<Heading class="govuk-heading-m rvs-news-card__title">
		<a class="govuk-link" href={href}>{title}</a>
	</Heading>
	{summary && <p class="govuk-body rvs-news-card__summary">{summary}</p>}
</li>

<style>
	.rvs-news-card {
		border-top: 4px solid var(--rvs-blue);
		padding: 15px 0 0;
	}

	.rvs-news-card__date {
		display: block;
		margin-bottom: 5px;
		color: var(--govuk-secondary-text-colour, #616365);
	}

	.rvs-news-card__title {
		margin: 0 0 10px;
	}

	.rvs-news-card__summary {
		margin: 0;
		text-wrap: pretty;
	}
</style>
