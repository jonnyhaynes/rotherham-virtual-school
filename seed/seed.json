		"faqs": [
			{
				"id": "faq-what-is-vs",
				"data": {
					"question": "What is a virtual school?",
					"audience": "all",
					"order": 10,
					"answer": [
						{
							"_type": "block",
							"style": "normal",
							"children": [
								{
									"_type": "span",
									"text": "A virtual school is not a building and children do not attend it. Every local authority in England must have one. It is a team of professionals who champion the education of children in care and make sure schools, carers and social workers are working together.",
									"_key": "k1"
								}
							],
							"_key": "k0"
						}
					]
				}
			},
			{
				"id": "faq-what-is-pep",
				"data": {
					"question": "What is a PEP?",
					"audience": "all",
					"order": 20,
					"answer": [
						{
							"_type": "block",
							"style": "normal",
							"children": [
								{
									"_type": "span",
									"text": "A Personal Education Plan (PEP) is a legal document that records what a child needs to do well in education, what support they will get, and who is responsible for it. Every child in care of school age must have a PEP that is reviewed at least three times a year.",
									"_key": "k1"
								}
							],
							"_key": "k0"
						}
					]
				}
			},
			{
				"id": "faq-ppp",
				"data": {
					"question": "What is Pupil Premium Plus?",
					"audience": "schools",
					"order": 30,
					"answer": [
						{
							"_type": "block",
							"style": "normal",
							"children": [
								{
									"_type": "span",
									"text": "Pupil Premium Plus (PP+) is additional funding paid to schools for children in care and previously looked-after children. It is meant to be spent on the specific educational needs identified in the child's PEP.",
									"_key": "k1"
								}
							],
							"_key": "k0"
						}
					]
				}
			},
			{
				"id": "faq-ask-for-help",
				"data": {
					"question": "How do I ask for help with a child's education?",
					"audience": "parents-carers",
					"order": 40,
					"answer": [
						{
							"_type": "block",
							"style": "normal",
							"children": [
								{
									"_type": "span",
									"text": "Start with your child's school or their social worker. If you are still worried, email the Virtual School and someone will get back to you.",
									"_key": "k1"
								}
							],
							"_key": "k0"
						}
					]
				}
			}
		],
