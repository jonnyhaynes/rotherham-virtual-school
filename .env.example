# EmDash plugin-secret encryption key. Generate with `npx emdash secrets generate`.
EMDASH_ENCRYPTION_KEY=

# Content database (libSQL / Turso). Leave unset locally to use file:./data.db.
LIBSQL_DATABASE_URL=
LIBSQL_AUTH_TOKEN=

# Media storage (S3-compatible: AWS S3, Backblaze B2, Supabase Storage, ...).
# Required in production builds; local dev uses ./uploads instead.
# Set to "local" to force filesystem storage (e.g. a local production build).
EMDASH_STORAGE=
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
S3_PUBLIC_URL=

# Session store for the EmDash admin. Required in production (Vercel supplies no
# default session driver). Local dev uses in-memory sessions instead.
REDIS_URL=
